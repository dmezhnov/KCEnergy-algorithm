for_each_element, filter_by_pair                    from ("matrix_operation.lang")
OVERALL_REQUEST_CAPACITY_COEFFICIENT, available_i_j from ("initial_data.example_2.lang")
requests_i_j                                        from ("step-1.example_2.lang")

threshold_i_j = for_each_element(available_i_j(1 from R), "*", OVERALL_REQUEST_CAPACITY_COEFFICIENT) = {
    (1 from I) = {
        (1 from I, 1 from J) = 1200 * OVERALL_REQUEST_CAPACITY_COEFFICIENT = 1200 * 1.2 = 1440,
        (1 from I, 2 from J) = 500  * OVERALL_REQUEST_CAPACITY_COEFFICIENT = 500  * 1.2 = 600,
        (1 from I, 3 from J) = 2500 * OVERALL_REQUEST_CAPACITY_COEFFICIENT = 2500 * 1.2 = 3000
    }
}
    where
        R from index # Индекс очереди
        I from index # Индексы нефпродукта
        J from index # Индексы НПЗ

requests_i_j_deficit = filter_by_pair(requests_i_j, ">=", threshold_i_j) = {
    (1 from I) = {
        (1 from I, 1 from J) = 2260, # 2260 >= 1140
        (1 from I, 2 from J) = 1030, # 1030 >= 600
    }
}
    where
        I from index # Индексы нефпродукта
        J from index # Индексы НПЗ

requests_i_j_surplus = filter_by_pair(requests_i_j, "<", threshold_i_j) = {
    (1 from I) = {
        (1 from I, 3 from J) = 2735 # 2735 < 3000
    }
}
    where
        I from index # Индексы нефпродукта
        J from index # Индексы НПЗ
