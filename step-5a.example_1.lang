# Объёмы Запросов второго условия поставки (EXW) IV очереди — пусто: Запросов EXW в IV очереди нет.
estimated_i_j_x_k_l_s_l0_q_second(4 from R)(1 from n) = filter_by_pair(assign_matrix(requests_allocated_second(4 from R)(1 from n)(1 from Z), ..., requests_allocated_second(4 from R)(1 from n)(39 from Z)), not_contains, sum_by_axes(estimated_i_j_x_k_l_s_l0_q_bonus(4 from R)(1 from n), Terminal, Queue, Ship_terms, Request)) = {}
