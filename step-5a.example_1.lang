# Объёмы Запросов первого условия поставки (FCA) IV очереди после первого прохода.
estimated_i_j_x_k_l_s_l0_q_first(4 from R)(1 from n) = for_each_pair(assign_matrix(requests_allocated_first(4 from R)(1 from n)(1 from Z), ..., requests_allocated_first(4 from R)(1 from n)(39 from Z)), "+", estimated_i_j_x_k_l_s_l0_q_bonus(4 from R)(1 from n)) = {
