estimated_i_j_x_k_l_s_l0_q(4 from R)(1 from n) = for_each_pair(for_each_element(filter_by_coordinate(requests_i_j_x_k_l_s_l0_q, Fourth), "*", 0), "+", assign_matrix(estimated_i_j_x_k_l_s_l0_q_first(4 from R)(1 from n), estimated_i_j_x_k_l_s_l0_q_second(4 from R)(1 from n))) = {
