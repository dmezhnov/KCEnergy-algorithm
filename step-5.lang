                s  for C  from index # Индексы условия поставки
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка

# 1-я матрица предварительных расчетных объемов НП для первой очереди
estimated_i_j_k_l_s(1 from R)(1 from n) = assign_matrix(estimated_i_j_k_l_s_not_exceed(1 from R), estimated_i_j_k_l_s_exceed(1 from R))
    where
        estimated_i_j_k_l_s(1 from R)(1)(i, j, s, k, l)         of number
        estimated_i_j_k_l_s_exceed(1 from R)(i, j, s, k, l)     of number
        estimated_i_j_k_l_s_not_exceed(1 from R)(i, j, s, k, l) of number
        estimated_i_j_k_l_s(1 from R)(1)         of matrix(Product, Refinery, Ship_terms, Region, Market_participant)
        estimated_i_j_k_l_s_exceed(1 from R)     of matrix(Product, Refinery, Ship_terms, Region, Market_participant)
        estimated_i_j_k_l_s_not_exceed(1 from R) of matrix(Product, Refinery, Ship_terms, Region, Market_participant)
            where
                R         from index # Индексы очереди
                n  of          index # Индекс матрицы
                Product, Refinery, Ship_terms, Region, Market_participant from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                s  for C  from index # Индексы условия поставки
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка

