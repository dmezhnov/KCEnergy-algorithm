requests_i_j_k_l_s_corrected_exceed(1 from R) = filter_by_pair(requests_i_j_k_l_s_corrected(1 from R), contains, requests_i_j_corrected_exceed(1 from R))
    where
        requests_i_j_k_l_s_corrected(1 from R)(i, j, s, k, l)        of number
        requests_i_j_k_l_s_corrected_exceed(1 from R)(i, j, s, k, l) of number
        requests_i_j_corrected_exceed(1 from R)(i, j)                of number
        requests_i_j_k_l_s_corrected(1 from R)        of matrix(Product, Refinery, Ship_terms, Region, Market_participant)
        requests_i_j_k_l_s_corrected_exceed(1 from R) of matrix(Product, Refinery, Ship_terms, Region, Market_participant)
        requests_i_j_corrected_exceed(1 from R)       of matrix(Product, Refinery)
        contains from condition
            where
                R         from index # Индексы очереди
                Product, Refinery, Ship_terms, Region, Market_participant from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                s  for C  from index # Индексы условия поставки
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка

# Матрица скорректированных объемов запрашиваемых субъектами рынка l0-й очереди, которые не превышают доступный объём
requests_i_j_k_l_s_corrected_not_exceed(l0) = filter_by_pair(requests_i_j_k_l_s_corrected(l0), contains, requests_i_j_corrected_not_exceed(l0))
    where
        requests_i_j_k_l_s_corrected(l0)(i, j, s, k, l)            of number
        requests_i_j_k_l_s_corrected_not_exceed(l0)(i, j, s, k, l) of number
        requests_i_j_corrected_not_exceed(l0)(i, j)                of number
        requests_i_j_k_l_s_corrected(l0)            of matrix(Product, Refinery, Ship_terms, Region, Market_participant)
        requests_i_j_k_l_s_corrected_not_exceed(l0) of matrix(Product, Refinery, Ship_terms, Region, Market_participant)
        requests_i_j_corrected_not_exceed(l0)       of matrix(Product, Refinery)
        contains from condition
            where
                l0 for R  from index # Индексы очереди
                Product, Refinery, Ship_terms, Region, Market_participant from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                s  for C  from index # Индексы условия поставки
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка

# Матрица скорректированных объемов запрашиваемых субъектами рынка первой очереди, которые не превышают доступный объём
requests_i_j_k_l_s_corrected_not_exceed(1 from R) = filter_by_pair(requests_i_j_k_l_s_corrected(1 from R), contains, requests_i_j_corrected_not_exceed(1 from R))
    where
