        estimated_i_j_k_l_s_not_exceed(1 from R)          of matrix(Product, Refinery, Ship_terms, Region, Market_participant)
        requests_i_j_k_l_s_corrected_not_exceed(1 from R) of matrix(Product, Refinery, Ship_terms, Region, Market_participant)
            where
