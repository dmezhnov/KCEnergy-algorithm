MAX_SUBJECT_SHARE_COEFFICIENT, available_i_j                                                from ("initial_data.example_1.lang")
normalized_i_j_k_l                                                                          from ("step-6.example_1.lang")
normalized_i_j_l                                                                            from ("step-7.1.example_1.lang")
for_each_element, filter_by_pair, for_each_pair, count_coordinates_by_axis, filter_by_value from ("matrix_operation.lang")

### Шаг 7.2. Уточнение нормированных объёмов НП первой очереди по предельной доле
# Сравниваем долю каждого Субъекта рынка на каждом НПЗ с предельной долей
# (δ × v_0ij, δ = 50%). Если доля субъекта превышает предел, его объёмы
# понижаются и матрица перенормируется (возврат к Шагу 6); иначе расчёт сходится.

# Предельный объём на одного Субъекта рынка на каждом НПЗ (порог δ × v_0ij):
# умножаем Доступный объём НПЗ (v_0ij) на предельную долю δ = 0.5.
normalized_i_j_threshold(1 from R)(1 from n) = for_each_element(available_i_j(1 from R), "*", MAX_SUBJECT_SHARE_COEFFICIENT) = {
    (1 from I) = {
        (1 from I, 1 from J) = 1200 * MAX_SUBJECT_SHARE_COEFFICIENT = 1200 * 0.5 =  600,
        (1 from I, 2 from J) =  500 * MAX_SUBJECT_SHARE_COEFFICIENT =  500 * 0.5 =  250,
        (1 from I, 3 from J) = 2500 * MAX_SUBJECT_SHARE_COEFFICIENT = 2500 * 0.5 = 1250
    }
}
    where
        n  of   index # Индекс матрицы
        I  from index # Индексы нефпродукта
        J  from index # Индексы НПЗ

# Доля каждого Субъекта рынка в Доступном объёме своего НПЗ (s̈_ijl / v_0ij).
# В самой проверке Шага 7.2 не участвует (сравнение идёт с порогом δ × v_0ij);
# это значение печатает трассировочная строка «Доля Субъекта рынка».
normalized_i_j_l_share(1 from R)(1 from n) = for_each_pair(normalized_i_j_l(1 from R)(1 from n), "/", available_i_j(1 from R)) = {
    (1 from I) = {
        (1 from I, 1 from J) = {
            (1 from I, 1 from J, 7  from P) =  55 / 1200 = 0.045833333333333333,  # 110
            (1 from I, 1 from J, 2  from P) = 585 / 1200 = 0.4875,                # 106
            (1 from I, 1 from J, 1  from P) = 150 / 1200 = 0.125,                 # 101 + 102 + 103
            (1 from I, 1 from J, 12 from P) = 130 / 1200 = 0.108333333333333333,  # 108
            (1 from I, 1 from J, 13 from P) = 165 / 1200 = 0.1375,                # 109
            (1 from I, 1 from J, 3  from P) =  80 / 1200 = 0.066666666666666666   # 107
        },
        (1 from I, 2 from J) = {
            (1 from I, 2 from J, 7  from P) =  30 /  500 = 0.06,                  # 111
            (1 from I, 2 from J, 18 from P) =  30 /  500 = 0.06,                  # 112
            (1 from I, 2 from J, 19 from P) =  20 /  500 = 0.04                   # 113
        }
    }
}
    where
        n  of   index # Индекс матрицы
        I  from index # Индексы нефпродукта
        J  from index # Индексы НПЗ
        P  from index # Индексы субъекта рынка

# Количество Субъектов рынка на каждом НПЗ (для проверки на монополию).
normalized_i_j_subject_count(1 from R)(1 from n) = count_coordinates_by_axis(normalized_i_j_l(1 from R)(1 from n), Market_participant) = {
    (1 from I) = {
        (1 from I, 1 from J) = 6,
        (1 from I, 2 from J) = 3
    }
}
    where
        n  of   index # Индекс матрицы
        I  from index # Индексы нефпродукта
        J  from index # Индексы НПЗ
        P  from index # Индексы субъекта рынка

# Оба НПЗ имеют более одного субъекта, поэтому проверка применяется к обоим.
normalized_i_j_subject_multiple(1 from R)(1 from n) = filter_by_value(normalized_i_j_subject_count(1 from R)(1 from n), "!=", 1) = {
    (1 from I) = {
        (1 from I, 1 from J) = 6,
        (1 from I, 2 from J) = 3
    }
}
    where
        n  of   index # Индекс матрицы
        I  from index # Индексы нефпродукта
        J  from index # Индексы НПЗ

# Субъекты, чья доля превышает предел (s̈_ijl > δ × v_0ij). Ни один не превышает:
# (1, 1) порог 600: P2 = 585, P13 = 165, P1 = 150, P12 = 130, P3 = 80, P7 = 55 — все < 600;
# (1, 2) порог 250: P7 = 30, P18 = 30, P19 = 20 — все < 250.
normalized_i_j_l_over_threshold(1 from R)(1 from n) = filter_by_pair(normalized_i_j_l(1 from R)(1 from n), ">", normalized_i_j_threshold(1 from R)(1 from n)) = {}
    where
        n  of   index # Индекс матрицы
        I  from index # Индексы нефпродукта
        J  from index # Индексы НПЗ
        P  from index # Индексы субъекта рынка

# Оба НПЗ многосубъектные, но множество превысивших пусто — корректировать нечего.
normalized_i_j_l_increased(1 from R)(1 from n) = filter_by_pair(normalized_i_j_l_over_threshold(1 from R)(1 from n), contains, normalized_i_j_subject_multiple(1 from R)(1 from n)) = {}
    where
        n  of   index # Индекс матрицы
        I  from index # Индексы нефпродукта
        J  from index # Индексы НПЗ
        P  from index # Индексы субъекта рынка

# Записи исходной матрицы для превысивших субъектов — пусто, т.к. превысивших нет.
normalized_i_j_k_l_increased(1 from R)(1 from n) = filter_by_pair(normalized_i_j_k_l(1 from R)(1 from n), contains, normalized_i_j_l_increased(1 from R)(1 from n)) = {}
    where
        n  of   index # Индекс матрицы
        I  from index # Индексы нефпродукта
        J  from index # Индексы НПЗ
        K  from index # Индексы региона
        P  from index # Индексы субъекта рынка

# Ограниченные предельным порогом объёмы — пусто.
normalized_i_j_k_l_limited(1 from R)(1 from n) = for_each_pair(normalized_i_j_k_l_increased(1 from R)(1 from n), "*", normalized_i_j_threshold(1 from R)(1 from n)) = {}
    where
        n  of   index # Индекс матрицы
        I  from index # Индексы нефпродукта
        J  from index # Индексы НПЗ
        K  from index # Индексы региона
        P  from index # Индексы субъекта рынка

# Скорректированные объёмы s⃛ × (δ × v_0ij) / s̈_ijl — пусто.
normalized_i_j_k_l_corrected(1 from R)(1 from n) = for_each_pair(normalized_i_j_k_l_limited(1 from R)(1 from n), "/", normalized_i_j_l(1 from R)(1 from n)) = {}
    where
        n  of   index # Индекс матрицы
        I  from index # Индексы нефпродукта
        J  from index # Индексы НПЗ
        K  from index # Индексы региона
        P  from index # Индексы субъекта рынка

# Набор коррекций пуст, поэтому на первой очереди итерация сходится: Шаг 7.2
# возвращает пустую матрицу estimated, и цикл нормирования завершается.
estimated_i_j_k_l(1 from R)(2 from n) = {}
    where
        is_empty( normalized_i_j_k_l_corrected(1 from R)(1 from n) ) = true
            where
                n  of   index # Индекс матрицы
                I  from index # Индексы нефпродукта
                J  from index # Индексы НПЗ
                K  from index # Индексы региона
                P  from index # Индексы субъекта рынка

