number                            from core
axis, index                       from ("matrix_types.lang")
sum_by_axes, filter_by_coordinate from ("matrix_operation.lang")
requests_i_j_x_k_l_s_l0           from ("step-minus-1.lang")

### Вычисляем суммарные запрашиваемые объемы по всем НПЗ и регионам поставки
# Отбираем Запросы на покупку НП на рассматриваемый период по виду НП,
# НПЗ и региону поставки и рассчитываем суммарные объёмы по всем Субъектам рынка.
# Результат — матрица суммарных объёмов по (Product, Refinery) для последующей
# проверки на дефицит/профицит.

# Заявки субъектов рынка за рассматриваемый период обслуживаемые в l0-ю очередь
requests_i_j_x_k_l_s(l0) = filter_by_coordinate(requests_i_j_x_k_l_s_l0, l0)
    where
        requests_i_j_x_k_l_s_l0(i, j, x, k, l, l0, s) of  number # Запрашиваемый объем НП
        requests_i_j_x_k_l_s(l0)(i, j, x, k, l, s)    of  number
        requests_i_j_x_k_l_s_l0  of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms)
        requests_i_j_x_k_l_s(l0) of matrix(Product, Refinery, Terminal, Region, Market_participant, Ship_terms)
            where
                R from Queue
                    where
                        Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms from axis # Оси заявок
                        i  for I  from index # Индексы нефпродукта
                        j  for J  from index # Индексы НПЗ
                        x  for X  from index # Индексы нефтебаз
                        k  for K  from index # Индексы региона
                        l  for P  from index # Индексы субъекта рынка
                        l0 for R  from index # Индексы очереди
                        s  for C  from index # Индексы условий поставки


# Заявки субъектов рынка за рассматриваемый период обслуживаемые в первую очередь
requests_i_j_x_k_l_s(1 from R) = filter_by_coordinate(requests_i_j_x_k_l_s_l0, First)
    where
        requests_i_j_x_k_l_s_l0(i, j, x, k, l, l0, s)     of  number # Запрашиваемый объем НП
        requests_i_j_x_k_l_s(1 from R)(i, j, x, k, l, s)  of  number
        requests_i_j_x_k_l_s_l0        of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms)
        requests_i_j_x_k_l_s(1 from R) of matrix(Product, Refinery, Terminal, Region, Market_participant,        Ship_terms)
            where
                First from Queue
                    where
                        Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms from axis # Оси заявок
                        i  for I  from index # Индексы нефпродукта
                        j  for J  from index # Индексы НПЗ
                        x  for X  from index # Индексы нефтебаз
                        k  for K  from index # Индексы региона
                        l  for P  from index # Индексы субъекта рынка
                        l0 for R  from index # Индексы очереди
                        s  for C  from index # Индексы условий поставки

requests_i_j_x_k_l_l0 = sum_by_axes(requests_i_j_x_k_l_s_l0, Ship_terms)
    where
        requests_i_j_x_k_l_s_l0(i, j, x, k, l, l0, s) of  number # Запрашиваемый объем НП
        requests_i_j_x_k_l_l0(i, j, x, k, l, l0)      of  number
        requests_i_j_x_k_l_s_l0 of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms)
        requests_i_j_x_k_l_l0   of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue)
            where
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms from axis # Оси заявок
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки

requests_i_j_x_k_l = sum_by_axes(requests_i_j_x_k_l_l0, Queue)
    where
        requests_i_j_x_k_l_l0(i, j, x, k, l, l0) of  number # Запрашиваемый объем НП
        requests_i_j_x_k_l(i, j, x, k, l)        of  number
        requests_i_j_x_k_l_l0 of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue)
        requests_i_j_x_k_l    of matrix(Product, Refinery, Terminal, Region, Market_participant)
        requests_i_j_x_k_l_l0(i, j, x, k, l, 1), ..., requests_i_j_x_k_l_l0(i, j, x, k, l, L0) => requests_i_j_x_k_l_l0(l0)
            where
                Product, Refinery, Terminal, Region, Market_participant, Queue from axis # Оси заявок
                i  for I  from index  # Индексы нефпродукта
                j  for J  from index  # Индексы НПЗ
                x  for X  from index  # Индексы нефтебаз
                k  for K  from index  # Индексы региона
                l  for P  from index  # Индексы субъекта рынка
                l0 for R  from index  # Индексы очереди
                L0        from index  # Количество очередей

requests_i_j_x_k = sum_by_axes(requests_i_j_x_k_l, Market_participant)
    where
        requests_i_j_x_k_l(i, j, x, k, l) of  number # Запрашиваемый объем НП
        requests_i_j_x_k(i, j, x, k)      of  number
        requests_i_j_x_k_l of matrix(Product, Refinery, Terminal, Region, Market_participant)
        requests_i_j_x_k   of matrix(Product, Refinery, Terminal, Region)
        requests_i_j_x_k_l(i, j, x, k, 1), ..., requests_i_j_x_k_l(i, j, x, k, L) => requests_i_j_x_k_l(l)
        requests_i_j_x_k(1),               ..., requests_i_j_x_k(N)               => requests_i_j_x_k(i)
            where
                requests_i_j_x_k_l(l) of matrix(Product, Refinery, Terminal, Region)
                requests_i_j_x_k(i)   of matrix(         Refinery, Terminal, Region)
                    where
                        Product, Refinery, Terminal, Region, Market_participant from axis # Оси заявок
                        i  for I  from index # Индексы нефпродукта
                        j  for J  from index # Индексы НПЗ
                        x  for X  from index # Индексы нефтебаз
                        k  for K  from index # Индексы региона
                        l  for P  from index # Индексы субъекта рынка
                        L         from index # Количество субъектов рынка
                        N         from index # Количество нефпродуктов


requests_i_j_x = sum_by_axes(requests_i_j_x_k_l, Region, Market_participant)
requests_i_j_x = sum_by_axes(requests_i_j_x_k,   Region)
    where
        requests_i_j_x_k_l(i, j, x, k, l) of  number # Запрашиваемый объем НП
        requests_i_j_x_k(i, j, x, k)      of  number
        requests_i_j_x(i, j, x)           of  number
        requests_i_j_x_k_l of matrix(Product, Refinery, Terminal, Region, Market_participant)
        requests_i_j_x_k   of matrix(Product, Refinery, Terminal, Region)
        requests_i_j_x     of matrix(Product, Refinery, Terminal)
        requests_i_j_x_k(i, j, x, 1),  ..., requests_i_j_x_k(i, j, x, Q)  => requests_i_j_x_k(k)
        requests_i_j_x(1),             ..., requests_i_j_x(I)             => requests_i_j_x(i)
            where
                Product, Region, Refinery, Terminal, Market_participant from axis # Оси агрегатов
                i  for I  from index # Индексы нефпродукта
                k  for K  from index # Индексы региона
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                l  for P  from index # Индексы субъекта рынка
                Q         from index # Количество регионов
                I         from index # Количество нефпродуктов

# Матрица объемов в запросах от всех субъектов ранка, размерами N x M
requests_i_j = sum_by_axes(requests_i_j_x, Terminal)
    where
        requests_i_j_x(i, j, x) of  number
        requests_i_j(i, j)      of  number
        requests_i_j_x of matrix(Product, Refinery, Terminal)
        requests_i_j   of matrix(Product, Refinery)
        requests_i_j_x(i, j, 1), ..., requests_i_j_x(i, j, X_leng) => requests_i_j_x(x)
            where
                Product, Refinery, Terminal from axis # Оси агрегатов
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                X_leng    from index # Количество нефтебаз

## Трассировочная строка для запроса № Request(q):
# Шаг 1. Суммарный запрашиваемый объем НП $Product(i) на НПЗ
# $Refinery(j), МТ: $requests_i_j(i, j)