number                            from core
axis, index                       from ("matrix_types.lang")
sum_by_axes, filter_by_coordinate from ("matrix_operation.lang")
requests_i_j_k_l_l0               from ("step-minus-1.lang")

### Вычисляем суммарные запрашиваемые объемы по всем НПЗ и регионам поставки
# Отбираем Запросы на покупку НП на рассматриваемый период по виду НП,
# НПЗ и региону поставки и рассчитываем суммарные объёмы по всем Субъектам рынка.
# Результат — матрица суммарных объёмов по (Product, Refinery) для последующей
# проверки на дефицит/профицит.

# Заявки субъектов рынка за рассматриваемый период обслуживаемые в l0-ю очередь
requests_i_j_k_l_queue(l0) = filter_by_coordinate(requests_i_j_k_l_l0, l0)
    where
        requests_i_j_k_l_l0(i, j, k, l, l0)    of  number # Запрашиваемый объем НП
        requests_i_j_k_l_queue(l0)(i, j, k, l) of  number
        requests_i_j_k_l_l0        of matrix(Product, Refinery, Region, Market_participant, Queue)
        requests_i_j_k_l_queue(l0) of matrix(Product, Refinery, Region, Market_participant)
            where
                R from Queue
                    where
                        Product, Refinery, Region, Market_participant, Queue from axis # Оси заявок
                        i  for I  from index # Индексы нефпродукта
                        j  for J  from index # Индексы НПЗ
                        k  for K  from index # Индексы региона
                        l  for P  from index # Индексы субъекта рынка
                        l0 for R  from index # Индексы очереди

# Заявки субъектов рынка за рассматриваемый период обслуживаемые в первую очередь
requests_i_j_k_l_queue(1 from R) = filter_by_coordinate(requests_i_j_k_l_l0, First)
    where
        requests_i_j_k_l_l0(i, j, k, l, l0)          of  number # Запрашиваемый объем НП
        requests_i_j_k_l_queue(1 from R)(i, j, k, l) of  number
        requests_i_j_k_l_l0              of matrix(Product, Refinery, Region, Market_participant, Queue)
        requests_i_j_k_l_queue(1 from R) of matrix(Product, Refinery, Region, Market_participant)
            where
                First from Queue
                    where
                        Product, Refinery, Region, Market_participant, Queue from axis # Оси заявок
                        i  for I  from index # Индексы нефпродукта
                        j  for J  from index # Индексы НПЗ
                        k  for K  from index # Индексы региона
                        l  for P  from index # Индексы субъекта рынка
                        l0 for R  from index # Индексы очереди

requests_i_j_k_l = sum_by_axes(requests_i_j_k_l_l0, Queue)
    where
        requests_i_j_k_l_l0(i, j, k, l, l0) of  number # Запрашиваемый объем НП
        requests_i_j_k_l(i, j, k, l)        of  number
        requests_i_j_k_l_l0 of matrix(Product, Refinery, Region, Market_participant, Queue)
        requests_i_j_k_l    of matrix(Product, Refinery, Region, Market_participant)
        requests_i_j_k_l_l0(i, j, k, l, 1), ..., requests_i_j_k_l_l0(i, j, k, l, L0) => requests_i_j_k_l_l0(l0)
            where
                Product, Refinery, Region, Market_participant, Queue from axis # Оси заявок
                i  for I  from index  # Индексы нефпродукта
                j  for J  from index  # Индексы НПЗ
                k  for K  from index  # Индексы региона
                l  for P  from index  # Индексы субъекта рынка
                l0 for R  from index  # Индексы очереди
                L0        from index  # Количество очередей

requests_i_j_k = sum_by_axes(requests_i_j_k_l, Market_participant)
    where
        requests_i_j_k_l(i, j, k, l) of  number # Запрашиваемый объем НП
        requests_i_j_k(i, j, k)      of  number
        requests_i_j_k_l of matrix(Product, Refinery, Region, Market_participant)
        requests_i_j_k   of matrix(Product, Refinery, Region)
        requests_i_j_k_l(i, j, k, 1), ..., requests_i_j_k_l(i, j, k, L) => requests_i_j_k_l(l)
        requests_i_j_k(1),            ..., requests_i_j_k(N)            => requests_i_j_k(i)
            where
                requests_i_j_k_l(l) of matrix(Product, Refinery, Region)
                requests_i_j_k(i)   of matrix(         Refinery, Region)
                    where
                        Product, Refinery, Region, Market_participant from axis # Оси заявок
                        i  for I  from index # Индексы нефпродукта
                        j  for J  from index # Индексы НПЗ
                        k  for K  from index # Индексы региона
                        l  for P  from index # Индексы субъекта рынка
                        L         from index # Количество субъектов рынка
                        N         from index # Количество нефпродуктов

# Матрица объемов в запросах от всех субъектов ранка, размерами N x M
requests_i_j = sum_by_axes(requests_i_j_k_l, Region, Market_participant)
requests_i_j = sum_by_axes(requests_i_j_k,   Region)
    where
        requests_i_j_k_l(i, j, k, l) of  number # Запрашиваемый объем НП
        requests_i_j_k(i, j, k)      of  number
        requests_i_j(i, j)           of  number
        requests_i_j_k_l of matrix(Product, Refinery, Region, Market_participant)
        requests_i_j_k   of matrix(Product, Refinery, Region)
        requests_i_j     of matrix(Product, Refinery)
        requests_i_j_k(i, j, 1), ..., requests_i_j_k(i, j, Q) => requests_i_j_k(k)
        requests_i_j(1),         ..., requests_i_j(I)         => requests_i_j(i)
            where
                Product, Region, Refinery, Market_participant from axis # Оси агрегатов
                i  for I  from index # Индексы нефпродукта
                k  for K  from index # Индексы региона
                j  for J  from index # Индексы НПЗ
                l  for P  from index # Индексы субъекта рынка
                Q         from index # Количество регионов
                I         from index # Количество нефпродуктов

## Трассировочная строка для запроса № Request(q):
# Шаг 1. Суммарный запрашиваемый объем НП $Product(i) на НПЗ
# $Refinery(j), МТ: $requests_i_j(i, j)
