        requests_i_j_x_k_l_s.First(i, j, x, s, k, l)   of number # Запрашиваемый объем НП
        requests_i_j_x_k_l_s_deficit(i, j, x, s, k, l) of number
        requests_i_j_deficit(i, j)                     of number
        requests_i_j_x_k_l_s.First   of matrix(Product, Refinery, Terminal, Ship_terms, Region, Market_participant)
        requests_i_j_x_k_l_s_deficit of matrix(Product, Refinery, Terminal, Ship_terms, Region, Market_participant)
        requests_i_j_deficit         of matrix(Product, Refinery)
