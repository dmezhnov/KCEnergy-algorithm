### Шаг 7.1. Суммарный нормированный объём НП первой очереди в разрезе НПЗ
# Суммируем нормированные предоставленные объёмы первой очереди (n = 1),
# сохраняя ось НПЗ (j):
# — по каждому Субъекту рынка с каждого НПЗ (s_ijl): свёртка по региону и условию поставки;
# — по всем Субъектам рынка с каждого НПЗ (итог по НПЗ, S_ij): доп. свёртка по Субъекту рынка.

# Суммарный нормированный объём НП каждому Субъекту рынка с каждого НПЗ (s_ijl):
# свёртка по региону (K) и условию поставки (C), объём по (i, j, l).
normalized_i_j_l(1 from R)(1 from n) = sum_by_axes(normalized_i_j_k_l_s(1 from R)(1 from n), Region, Ship_terms) = {
    (1 from I) = {
        (1 from I, 1 from J) = {
            (1 from I, 1 from J, 2  from P)                = 585,  # 106
            (1 from I, 1 from J, 1  from P) = 65 +  5 + 80 = 150,  # 101 + 102 + 103
            (1 from I, 1 from J, 12 from P)                = 195,  # 108
            (1 from I, 1 from J, 7  from P)                = 60,   # 110
            (1 from I, 1 from J, 13 from P)                = 170,  # 109
            (1 from I, 1 from J, 3  from P)                = 85    # 107
        },
        (1 from I, 2 from J) = {
            (1 from I, 2 from J, 1  from P)                = 30,   # 104
            (1 from I, 2 from J, 7  from P)                = 30,   # 111
            (1 from I, 2 from J, 18 from P)                = 30,   # 112
            (1 from I, 2 from J, 19 from P)                = 20    # 113
        },
        (1 from I, 3 from J) = {
            (1 from I, 3 from J, 1  from P)                = 600   # 105
        }
    }
}
    where
        n  of   index # Индекс матрицы
        C  from index # Индексы условия поставки
        I  from index # Индексы нефпродукта
        J  from index # Индексы НПЗ
        K  from index # Индексы региона
        P  from index # Индексы субъекта рынка

# Суммарный нормированный объём НП всем Субъектам рынка с каждого НПЗ (итог по НПЗ, S_ij):
# доп. свёртка по Субъекту рынка (P), объём по (i, j).
normalized_i_j(1 from R)(1 from n) = sum_by_axes(normalized_i_j_l(1 from R)(1 from n), Market_participant) = {
    (1 from I) = {
        (1 from I, 1 from J) = 585 + 150 + 195 +  60 + 170 +  85 = 1245,  # 101 + 102 + 103 + 106 + 107 + 108 + 109 + 110
        (1 from I, 2 from J) =              30 +  30 +  30 +  20 = 110,   # 104 + 111 + 112 + 113
        (1 from I, 3 from J)                                     = 600    # 105
    }
}
    where
        n  of   index # Индекс матрицы
        I  from index # Индексы нефпродукта
        J  from index # Индексы НПЗ
        P  from index # Индексы субъекта рынка
