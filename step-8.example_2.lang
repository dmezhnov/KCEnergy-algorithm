length, number             from core
estimated_i_j_k_l          from ("step-7.2.example_2.lang")
normalized_i_j_k_l         from ("step-6.example_2.lang")
available_i_j              from ("initial_data.example_2.lang")
for_each_pair, sum_by_axes from ("matrix_operation.lang")
operation                  from ("matrix_types.lang")

### Шаг 8. Оставшийся после распределения Владельцам АЗС объём НП (пример 2)
# Остатки по (Product, Refinery) после распределения первой очереди (Владельцы АЗС):
# доступный объём v0 минус суммарно предоставленный Владельцам АЗС (свёртка s̈ по k, l).
# Цикл нормирования первой очереди сошёлся на n = 1 (Шаг 7.2 ничего не урезал), поэтому
# берётся нормированная матрица Шага 6 первой итерации.

# Последняя матрица предварительных расчётных объёмов НП первой очереди (s̈).
estimated_i_j_k_l_last(1 from R) = normalized_i_j_k_l(1 from R)(last_n) = {
    (1 from I) = {
        (1 from I, 1 from J) = {
            (1 from I, 1 from J, 1 from K) = {
                (1 from I, 1 from J, 1 from K, 7  from P) = 60    # 110
            },
            (1 from I, 1 from J, 3 from K) = {
                (1 from I, 1 from J, 3 from K, 2  from P) = 585   # 106
            },
            (1 from I, 1 from J, 4 from K) = {
                (1 from I, 1 from J, 4 from K, 1  from P) = 15,   # 101 + 102
                (1 from I, 1 from J, 4 from K, 12 from P) = 195,  # 108
                (1 from I, 1 from J, 4 from K, 13 from P) = 170   # 109
            },
            (1 from I, 1 from J, 5 from K) = {
                (1 from I, 1 from J, 5 from K, 1  from P) = 80,   # 103
                (1 from I, 1 from J, 5 from K, 3  from P) = 85    # 107
            }
        },
        (1 from I, 2 from J) = {
            (1 from I, 2 from J, 4 from K) = {
                (1 from I, 2 from J, 4 from K, 1  from P) = 30,   # 104
                (1 from I, 2 from J, 4 from K, 7  from P) = 30,   # 111
                (1 from I, 2 from J, 4 from K, 18 from P) = 30,   # 112
                (1 from I, 2 from J, 4 from K, 19 from P) = 20    # 113
            }
        },
        (1 from I, 3 from J) = {
            (1 from I, 3 from J, 4 from K) = {
                (1 from I, 3 from J, 4 from K, 1  from P) = 600   # 105
            }
        }
    }
}
    where
        estimated_i_j_k_l_last(1 from R)(i, l, j, k)     of number
        normalized_i_j_k_l(1 from R)(last_n)(i, l, j, k) of number
        estimated_i_j_k_l(1 from R)      of matrix(Product, Refinery, Market_participant, Region)
        estimated_i_j_k_l_last(1 from R) of matrix(Product, Refinery, Market_participant, Region)
            where
                last_n    of   index = length(estimated_i_j_k_l(1 from R)) - 1 # индекс последней итерации нормирования
                Product, Market_participant, Refinery, Region from axis
                i  for I  from index # Индексы нефпродукта
                l  for P  from index # Индексы субъекта рынка
                j  for J  from index # Индексы НПЗ
                k  for K  from index # Индексы региона

# Суммарно предоставленный Владельцам АЗС объём по НПЗ (свёртка s̈ по региону и субъекту).
estimated_i_j_last(1 from R) = sum_by_axes(estimated_i_j_k_l_last(1 from R), Region, Market_participant) = {
    (1 from I) = {
        (1 from I, 1 from J) =  60 + 585 +  15 + 195 + 170 +  80 +  85 = 1190,  # 101 + 102 + 103 + 106 + 107 + 108 + 109 + 110
        (1 from I, 2 from J) =  30 +  30 +  30 +  20                   = 110,   # 104 + 111 + 112 + 113
        (1 from I, 3 from J)                                           = 600    # 105
    }
}
    where
        estimated_i_j_k_l_last(1 from R)(i, j, l, k) of number
        estimated_i_j_last(1 from R)(i, j)           of number
        estimated_i_j_k_l_last(1 from R) of matrix(Product, Refinery, Market_participant, Region)
        estimated_i_j_last(1 from R)     of matrix(Product, Refinery)
            where
                Product, Market_participant, Refinery, Region from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                l  for P  from index # Индексы субъекта рынка
                k  for K  from index # Индексы региона

# Матрица оставшихся после распределения Владельцам АЗС объёмов НП первой очереди (v2 = v0 - s̈).
# На всех трёх НПЗ было распределение первой очереди, включая монопольный ПНХЗ (Запрос 105).
available_i_j_new(1 from R) = for_each_pair(available_i_j(1 from R), "-", estimated_i_j_last(1 from R)) = {
    (1 from I) = {
        (1 from I, 1 from J) = 1200 - 1190 =   10,
        (1 from I, 2 from J) =  500 -  110 =  390,
        (1 from I, 3 from J) = 2500 -  600 = 1900
    }
}
    where
        available_i_j_new(1 from R)(i, j)  of number
        available_i_j(1 from R)(i, j)      of number
        estimated_i_j_last(1 from R)(i, j) of number
        available_i_j_new(1 from R)  of matrix(Product, Refinery)
        available_i_j(1 from R)      of matrix(Product, Refinery)
        estimated_i_j_last(1 from R) of matrix(Product, Refinery)
        "-" from operation
            where
                Product, Refinery from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
