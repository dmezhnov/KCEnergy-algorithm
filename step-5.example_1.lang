# распределяем доступное пропорционально скорректированным запросам (дефицит).
# Иначе удовлетворяем запросы в полном объёме (профицит/достаточность).

# Итоговые объёмы Запросов первой очереди, которые превышают доступный объём.
requests_i_j_corrected_exceed.First = filter_by_pair(requests_i_j_corrected.First, ">", available_i_j.First) = {
    (1 from I) = {
        (1 from I, 1 from J) = 1465  # 1200 < 1465 -> 101 + 102 + 103 + 106 + 107 + 108 + 109 + 110
    }
}
    where
        I from index # Индексы нефпродукта
        J from index # Индексы НПЗ

# Итоговые объёмы Запросов первой очереди, которые не превышают доступный объём.
