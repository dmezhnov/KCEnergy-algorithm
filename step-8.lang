length, number             from core
estimated_i_j_k_l          from ("step-7.2.lang")
normalized_i_j_k_l         from ("step-6.lang")
available_i_j              from ("initial_data.lang")
for_each_pair, sum_by_axes from ("matrix_operation.lang")
operation                  from ("matrix_types.lang")

### Оставшийся после распределения Владельцам АЗС объем НП
# Вычисляем остатки по (Product, Refinery) после распределения Владельцам АЗС:
# доступный объём минус суммарно предоставленный Владельцам АЗС.

# Последняя матрица нормированных объемов НП первой очереди: итерация цикла Шагов 6-7,
# после которой Шаг 7.2 ничего не урезал. Последний член estimated_i_j_k_l — пустая
# матрица, которой Шаг 7.2 завершает цикл, поэтому last_n на единицу меньше его длины.
# Шаги 7-8 применяются только к реальной I очереди; виртуальные II и III очереди распределяются в Шагах 4-6 (step-10/step-13) и сюда не попадают
estimated_i_j_k_l_last(1 from R) = normalized_i_j_k_l(1 from R)(last_n)
    where
        estimated_i_j_k_l_last(1 from R)(i, l, j, k)     of number
        normalized_i_j_k_l(1 from R)(last_n)(i, l, j, k) of number
        estimated_i_j_k_l(1 from R)      of matrix(Product, Refinery, Market_participant, Region)
        estimated_i_j_k_l_last(1 from R) of matrix(Product, Refinery, Market_participant, Region)
            where
                last_n    of   index = length(estimated_i_j_k_l(1 from R)) - 1 # индекс последней итерации нормирования
                Product, Market_participant, Refinery, Region from axis
                i  for I  from index # Индексы нефпродукта
                l  for P  from index # Индексы субъекта рынка
                j  for J  from index # Индексы НПЗ
                k  for K  from index # Индексы региона

# Шаги 7-8 применяются только к реальной I очереди; виртуальные II и III очереди распределяются в Шагах 4-6 (step-10/step-13) и сюда не попадают
estimated_i_j_last(1 from R) = sum_by_axes(estimated_i_j_k_l_last(1 from R), Region, Market_participant)
    where
        estimated_i_j_k_l_last(1 from R)(i, j, l, k) of number
        estimated_i_j_last(1 from R)(i, j)           of number
        estimated_i_j_k_l_last(1 from R) of matrix(Product, Refinery, Market_participant, Region)
        estimated_i_j_last(1 from R)     of matrix(Product, Refinery)
            where
                Product, Market_participant, Refinery, Region from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                l  for P  from index # Индексы субъекта рынка
                k  for K  from index # Индексы региона

