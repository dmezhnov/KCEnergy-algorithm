available_i_j_new                               from ("step-11.lang")
MIN_NEXT_AVAIL_TONNAGE                          from ("step-9.lang")
OIL_TERMINAL_MIN_TONNAGE, RAIL_ROAD_MIN_TONNAGE from ("initial_data.lang")
filter_by_value                                 from ("matrix_operation.lang")
condition, index, axis                          from ("matrix_types.lang")

### Шаг 12. Оставшиеся объёмы позволяют удовлетворить Запросы Субъектов рынка из состава ГМК?
# Система проверяет, существует ли НПЗ, чей оставшийся после распределения среди Владельцев
# нефтебаз/резервуаров объём НП достаточен для обслуживания Запросов горно-металлургического
# комплекса (ГМК — Субъекты рынка, чьи Запросы отнесены к следующей очереди; приобретение НП
# на условиях отгрузки с нефтебаз):
#   ∃ i ∈ I, j ∈ J: v3_ij > min(L_r, L_t),
# где
#   v3_ij  — оставшийся после распределения среди Владельцев нефтебаз/резервуаров объём i-го
#            вида НП на j-м НПЗ (Шаг 11): available_i_j_new(l0 from R);
#   L_r    — объём вагонной нормы, МТ: RAIL_ROAD_MIN_TONNAGE;
#   L_t    — объём нормы Запроса на покупку НП с нефтебазы, МТ: OIL_TERMINAL_MIN_TONNAGE.
# Порог min(L_r, L_t) вычисляет MIN_NEXT_AVAIL_TONNAGE (Шаг 9), одинаковый для всех очередей.
# Если найдётся хотя бы один такой НПЗ (available_i_j(l0 + 1 from R) непуста) — Система
# переходит к Шагу 13, иначе — конец алгоритма.

# Доступные объёмы для следующей очереди (ГМК): остаток строго больше нормы (v3 > min(L_r, L_t)).
available_i_j(l0 + 1 from R) = filter_by_value(available_i_j_new(l0 from R), ">", MIN_NEXT_AVAIL_TONNAGE(l0 from R))
    where
        available_i_j_new(l0 from R)(i, j) of number
        MIN_NEXT_AVAIL_TONNAGE(l0 from R)  of number
        available_i_j(l0 + 1 from R)(i, j) of number
        available_i_j_new(l0 from R) of matrix(Product, Refinery)
        available_i_j(l0 + 1 from R) of matrix(Product, Refinery)
        ">" from condition
            where
                l0 for R  from index # Индексы очереди
                Product, Refinery from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
