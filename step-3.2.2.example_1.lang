# Объединённая матрица скорректированных на проливы объёмов по всем запросам первой очереди (вспомогательная, до ограничения объёмом запроса):
# единичные дефицитные (Шаг 3.2.1, _corrected) + множественные дефицитные (Шаг 3.2.2, _pend_aux) + профицитные (полный запрашиваемый объём).
requests_i_j_k_l_corrected_aux = assign_matrix(requests_i_j_k_l_deficit_single_corrected, requests_i_j_k_l_deficit_multiple_pend_aux, requests_i_j_k_l_surplus) = {
    (1 from I) = {
        (1 from I, 1 from J) = {
            (1 from I, 1 from J, 1 from K) = {
                (1 from I, 1 from J, 1 from K, 7  from P) = 85    # 110
            },
            (1 from I, 1 from J, 3 from K) = {
                (1 from I, 1 from J, 3 from K, 2  from P) = 750   # 106
            },
            (1 from I, 1 from J, 4 from K) = {
                (1 from I, 1 from J, 4 from K, 1  from P) = 90,   # 101 + 102
                (1 from I, 1 from J, 4 from K, 12 from P) = 200,  # 108
                (1 from I, 1 from J, 4 from K, 13 from P) = 200   # 109
            },
            (1 from I, 1 from J, 5 from K) = {
                (1 from I, 1 from J, 5 from K, 1  from P) = 90,   # 103
                (1 from I, 1 from J, 5 from K, 3  from P) = 100   # 107
            }
        },
        (1 from I, 2 from J) = {
            (1 from I, 2 from J, 4 from K) = {
                (1 from I, 2 from J, 4 from K, 7  from P) = 30,   # 111
                (1 from I, 2 from J, 4 from K, 18 from P) = 30,   # 112
                (1 from I, 2 from J, 4 from K, 19 from P) = 20    # 113
            }
        }
    }
}
    where
        I from index # Индексы нефпродукта
        J from index # Индексы НПЗ
        K from index # Индексы региона
        P from index # Индексы субъекта рынка

# Итоговый скорректированный на проливы объём по всем запросам первой очереди (Таблица 68):
# min(запрос, вспомогательный объём). Меняются только #106 (750 -> 715) и #110 (85 -> 70),
# где запрос меньше; остальные уже не превышали запрос.
requests_i_j_k_l_corrected = for_each_pair(requests_i_j_k_l_queue(1 from R), min, requests_i_j_k_l_corrected_aux) = {
    (1 from I) = {
        (1 from I, 1 from J) = {
            (1 from I, 1 from J, 1 from K) = {
                (1 from I, 1 from J, 1 from K, 7  from P) = min(70, 85)   = 70    # 110
            },
            (1 from I, 1 from J, 3 from K) = {
                (1 from I, 1 from J, 3 from K, 2  from P) = min(715, 750) = 715   # 106
            },
            (1 from I, 1 from J, 4 from K) = {
                (1 from I, 1 from J, 4 from K, 1  from P) = min(230, 90)  = 90,   # 101 + 102
                (1 from I, 1 from J, 4 from K, 12 from P) = min(325, 200) = 200,  # 108
                (1 from I, 1 from J, 4 from K, 13 from P) = min(325, 200) = 200   # 109
            },
            (1 from I, 1 from J, 5 from K) = {
                (1 from I, 1 from J, 5 from K, 1  from P) = min(150, 90)  = 90,   # 103
                (1 from I, 1 from J, 5 from K, 3  from P) = min(200, 100) = 100   # 107
            }
        },
        (1 from I, 2 from J) = {
            (1 from I, 2 from J, 4 from K) = {
                (1 from I, 2 from J, 4 from K, 7  from P) = min(100, 30)  = 30,   # 111
                (1 from I, 2 from J, 4 from K, 18 from P) = min(100, 30)  = 30,   # 112
                (1 from I, 2 from J, 4 from K, 19 from P) = min(50, 20)   = 20    # 113
            }
        }
    }
}
    where
        I from index # Индексы нефпродукта
        J from index # Индексы НПЗ
        K from index # Индексы региона
        P from index # Индексы субъекта рынка
        R from index # Индексы очереди
