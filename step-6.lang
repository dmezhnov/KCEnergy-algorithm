number                                                                     from core
RAIL_ROAD_MIN_TONNAGE, OIL_TERMINAL_MIN_TONNAGE, OIL_TERMINAL_STEP_TONNAGE from ("initial_data.lang")
estimated_i_j_k_l                                                          from ("step-5.lang")
requests_i_j_k_l_s_l0                                                      from ("step-minus-1.lang")
axis, index, matrix, operation, coordinate, condition                      from ("matrix_types.lang")
filter_by_coordinate, filter_by_value, filter_by_pair                      from ("matrix_operation.lang")
count_coordinates_by_axis, for_each_element, assign_matrix                 from ("matrix_operation.lang")

### Предварительное итоговое распределение (нормирование)
# Нормируем (округляем) предварительно предоставленные объёмы по правилам:
# — для НПЗ — до кратности вагонной норме (по умолчанию 65 МТ) вверх/вниз по правилам 0.5;
# — для нефтебаз — до не ниже минимальной нормы и кратности шагу вывоза.
# После контроля доли (Шаг 7) возможно повторное нормирование.

# Условие поставки выбирается на всю группу обслуживания, а не на отдельный Запрос: после
# агрегации (Шаг −1) в группе может быть заявлено одно условие поставки или оба сразу.
# Если условие одно — группа нормируется по нему, как и до агрегации. Если заявлены оба —
# условие выбирается по вагонной норме: распределение меньше вагонной нормы нормируется по
# условию EXW (с нефтебазы), иначе — по условию FCA (с НПЗ). Отказа как такового здесь нет:
# объёмы Запросов невыбранного условия обнуляются при разагрегации в Шаге n+1.

# Количество условий поставки, заявленных в группе обслуживания
ship_terms_count_by_requests_l0 = count_coordinates_by_axis(requests_i_j_k_l_s_l0, Ship_terms)
    where
        ship_terms_count_by_requests_l0(i, j, k, l, l0) of number
        requests_i_j_k_l_s_l0(i, j, k, l, s, l0)        of number
        ship_terms_count_by_requests_l0 of matrix(Product, Refinery, Region, Market_participant, Queue)
        requests_i_j_k_l_s_l0           of matrix(Product, Refinery, Region, Market_participant, Ship_terms, Queue)
        Ship_terms from axis # Ось условий поставки
            where
                Product, Refinery, Region, Market_participant, Ship_terms, Queue from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                s  for C  from index # Индексы условия поставки
                l0 for R  from index # Индексы очереди

# Группы обслуживания, в которых заявлено единственное условие поставки
ship_terms_count_by_requests_l0_single = filter_by_value(ship_terms_count_by_requests_l0, "=", 1)
    where
        ship_terms_count_by_requests_l0_single(i, j, k, l, l0) of number
        ship_terms_count_by_requests_l0(i, j, k, l, l0)        of number
        ship_terms_count_by_requests_l0_single of matrix(Product, Refinery, Region, Market_participant, Queue)
        ship_terms_count_by_requests_l0        of matrix(Product, Refinery, Region, Market_participant, Queue)
        "=" from condition
            where
                Product, Refinery, Region, Market_participant, Queue from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди

# Группы обслуживания, в которых заявлены оба условия поставки
ship_terms_count_by_requests_l0_multiple = filter_by_value(ship_terms_count_by_requests_l0, "!=", 1)
    where
        ship_terms_count_by_requests_l0_multiple(i, j, k, l, l0) of number
        ship_terms_count_by_requests_l0(i, j, k, l, l0)          of number
        ship_terms_count_by_requests_l0_multiple of matrix(Product, Refinery, Region, Market_participant, Queue)
        ship_terms_count_by_requests_l0          of matrix(Product, Refinery, Region, Market_participant, Queue)
        "!=" from condition
            where
                Product, Refinery, Region, Market_participant, Queue from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди

# n-я матрица предварительных расчетных объемов НП l0-й очереди, с единственным условием поставки
estimated_i_j_k_l_single(l0)(n) = filter_by_pair(estimated_i_j_k_l(l0)(n), contains, filter_by_coordinate(ship_terms_count_by_requests_l0_single, l0))
    where
        estimated_i_j_k_l_single(l0)(n)(i, j, k, l)            of number
        estimated_i_j_k_l(l0)(n)(i, j, k, l)                   of number
        ship_terms_count_by_requests_l0_single(i, j, k, l, l0) of number
        estimated_i_j_k_l_single(l0)(n)        of matrix(Product, Refinery, Region, Market_participant)
        estimated_i_j_k_l(l0)(n)               of matrix(Product, Refinery, Region, Market_participant)
        ship_terms_count_by_requests_l0_single of matrix(Product, Refinery, Region, Market_participant, Queue)
        contains from condition
            where
                l0 from Queue
                    where
                        n  of          index # Индекс матрицы
                        Product, Refinery, Region, Market_participant, Queue from axis
                        i  for I  from index # Индексы нефпродукта
                        j  for J  from index # Индексы НПЗ
                        k  for K  from index # Индексы региона
                        l  for P  from index # Индексы субъекта рынка
                        l0 for R  from index # Индексы очереди

# n-я матрица предварительных расчетных объемов НП первой очереди, с единственным условием поставки
estimated_i_j_k_l_single(1 from R)(n) = filter_by_pair(estimated_i_j_k_l(1 from R)(n), contains, filter_by_coordinate(ship_terms_count_by_requests_l0_single, First))
    where
        estimated_i_j_k_l_single(1 from R)(n)(i, j, k, l)      of number
        estimated_i_j_k_l(1 from R)(n)(i, j, k, l)             of number
        ship_terms_count_by_requests_l0_single(i, j, k, l, l0) of number
        estimated_i_j_k_l_single(1 from R)(n)  of matrix(Product, Refinery, Region, Market_participant)
        estimated_i_j_k_l(1 from R)(n)         of matrix(Product, Refinery, Region, Market_participant)
        ship_terms_count_by_requests_l0_single of matrix(Product, Refinery, Region, Market_participant, Queue)
        contains from condition
            where
                First from Queue
                    where
                        n  of          index # Индекс матрицы
                        Product, Refinery, Region, Market_participant, Queue from axis
                        i  for I  from index # Индексы нефпродукта
                        j  for J  from index # Индексы НПЗ
                        k  for K  from index # Индексы региона
                        l  for P  from index # Индексы субъекта рынка
                        l0 for R  from index # Индексы очереди

# n-я матрица предварительных расчетных объемов НП l0-й очереди, с обоими условиями поставки
estimated_i_j_k_l_multiple(l0)(n) = filter_by_pair(estimated_i_j_k_l(l0)(n), contains, filter_by_coordinate(ship_terms_count_by_requests_l0_multiple, l0))
    where
        estimated_i_j_k_l_multiple(l0)(n)(i, j, k, l)            of number
        estimated_i_j_k_l(l0)(n)(i, j, k, l)                     of number
        ship_terms_count_by_requests_l0_multiple(i, j, k, l, l0) of number
        estimated_i_j_k_l_multiple(l0)(n)        of matrix(Product, Refinery, Region, Market_participant)
        estimated_i_j_k_l(l0)(n)                 of matrix(Product, Refinery, Region, Market_participant)
        ship_terms_count_by_requests_l0_multiple of matrix(Product, Refinery, Region, Market_participant, Queue)
        contains from condition
            where
                l0 from Queue
                    where
                        n  of          index # Индекс матрицы
                        Product, Refinery, Region, Market_participant, Queue from axis
                        i  for I  from index # Индексы нефпродукта
                        j  for J  from index # Индексы НПЗ
                        k  for K  from index # Индексы региона
                        l  for P  from index # Индексы субъекта рынка
                        l0 for R  from index # Индексы очереди

# n-я матрица предварительных расчетных объемов НП первой очереди, с обоими условиями поставки
estimated_i_j_k_l_multiple(1 from R)(n) = filter_by_pair(estimated_i_j_k_l(1 from R)(n), contains, filter_by_coordinate(ship_terms_count_by_requests_l0_multiple, First))
    where
        estimated_i_j_k_l_multiple(1 from R)(n)(i, j, k, l)      of number
        estimated_i_j_k_l(1 from R)(n)(i, j, k, l)               of number
        ship_terms_count_by_requests_l0_multiple(i, j, k, l, l0) of number
        estimated_i_j_k_l_multiple(1 from R)(n)  of matrix(Product, Refinery, Region, Market_participant)
        estimated_i_j_k_l(1 from R)(n)           of matrix(Product, Refinery, Region, Market_participant)
        ship_terms_count_by_requests_l0_multiple of matrix(Product, Refinery, Region, Market_participant, Queue)
        contains from condition
            where
                First from Queue
                    where
                        n  of          index # Индекс матрицы
                        Product, Refinery, Region, Market_participant, Queue from axis
                        i  for I  from index # Индексы нефпродукта
                        j  for J  from index # Индексы НПЗ
                        k  for K  from index # Индексы региона
                        l  for P  from index # Индексы субъекта рынка
                        l0 for R  from index # Индексы очереди

# n-я матрица предварительных расчетных объемов НП l0-й очереди, для поставки с НПЗ: группы с
# единственным условием поставки FCA и группы с обоими условиями, выбравшие FCA по вагонной норме
estimated_i_j_k_l_fca(l0)(n) = assign_matrix(filter_by_pair(estimated_i_j_k_l_single(l0)(n), contains, filter_by_coordinate(requests_i_j_k_l_s_l0, l0, FCA)), filter_by_value(estimated_i_j_k_l_multiple(l0)(n), ">=", RAIL_ROAD_MIN_TONNAGE))
    where
        estimated_i_j_k_l_fca(l0)(n)(i, j, k, l)      of number
        estimated_i_j_k_l_single(l0)(n)(i, j, k, l)   of number
        estimated_i_j_k_l_multiple(l0)(n)(i, j, k, l) of number
        requests_i_j_k_l_s_l0(i, j, k, l, s, l0)      of number
        RAIL_ROAD_MIN_TONNAGE                         of number
        estimated_i_j_k_l_fca(l0)(n)      of matrix(Product, Refinery, Region, Market_participant)
        estimated_i_j_k_l_single(l0)(n)   of matrix(Product, Refinery, Region, Market_participant)
        estimated_i_j_k_l_multiple(l0)(n) of matrix(Product, Refinery, Region, Market_participant)
        requests_i_j_k_l_s_l0             of matrix(Product, Refinery, Region, Market_participant, Ship_terms, Queue)
        FCA from coordinate
        contains, ">=" from condition
            where
                l0 from Queue
                    where
                        n  of          index # Индекс матрицы
                        Product, Refinery, Region, Market_participant, Ship_terms, Queue from axis
                        i  for I  from index # Индексы нефпродукта
                        j  for J  from index # Индексы НПЗ
                        k  for K  from index # Индексы региона
                        l  for P  from index # Индексы субъекта рынка
                        s  for C  from index # Индексы условия поставки
                        l0 for R  from index # Индексы очереди

# n-я матрица предварительных расчетных объемов НП первой очереди, для поставки с НПЗ: группы с
# единственным условием поставки FCA и группы с обоими условиями, выбравшие FCA по вагонной норме
estimated_i_j_k_l_fca(1 from R)(n) = assign_matrix(filter_by_pair(estimated_i_j_k_l_single(1 from R)(n), contains, filter_by_coordinate(requests_i_j_k_l_s_l0, First, FCA)), filter_by_value(estimated_i_j_k_l_multiple(1 from R)(n), ">=", RAIL_ROAD_MIN_TONNAGE))
    where
        estimated_i_j_k_l_fca(1 from R)(n)(i, j, k, l)      of number
        estimated_i_j_k_l_single(1 from R)(n)(i, j, k, l)   of number
        estimated_i_j_k_l_multiple(1 from R)(n)(i, j, k, l) of number
        requests_i_j_k_l_s_l0(i, j, k, l, s, l0)            of number
        RAIL_ROAD_MIN_TONNAGE                               of number
        estimated_i_j_k_l_fca(1 from R)(n)      of matrix(Product, Refinery, Region, Market_participant)
        estimated_i_j_k_l_single(1 from R)(n)   of matrix(Product, Refinery, Region, Market_participant)
        estimated_i_j_k_l_multiple(1 from R)(n) of matrix(Product, Refinery, Region, Market_participant)
        requests_i_j_k_l_s_l0                   of matrix(Product, Refinery, Region, Market_participant, Ship_terms, Queue)
        FCA from coordinate
        contains, ">=" from condition
            where
                First from Queue
                    where
                        n  of          index # Индекс матрицы
                        Product, Refinery, Region, Market_participant, Ship_terms, Queue from axis
                        i  for I  from index # Индексы нефпродукта
                        j  for J  from index # Индексы НПЗ
                        k  for K  from index # Индексы региона
                        l  for P  from index # Индексы субъекта рынка
                        s  for C  from index # Индексы условия поставки
                        l0 for R  from index # Индексы очереди

# n-я матрица коэффициентов, для расчета нормированных объемов lo-й очереди НП, для поставки с НПЗ
estimated_i_j_k_l_fca_coeff(l0)(n) = for_each_element(estimated_i_j_k_l_fca(l0)(n), safe_divide, RAIL_ROAD_MIN_TONNAGE)
    where
        estimated_i_j_k_l_fca_coeff(l0)(n)(i, j, k, l) of number
        estimated_i_j_k_l_fca(l0)(n)(i, j, k, l)       of number
        RAIL_ROAD_MIN_TONNAGE                          of number
        estimated_i_j_k_l_fca_coeff(l0)(n) of matrix(Product, Refinery, Region, Market_participant)
        estimated_i_j_k_l_fca(l0)(n)       of matrix(Product, Refinery, Region, Market_participant)
        safe_divide from operation
            where
                l0 for R  from index # Индексы очереди
                n  of          index # Индекс матрицы
                Product, Refinery, Region, Market_participant from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка

# n-я матрица коэффициентов, для расчета нормированных объемов первой очереди НП, для поставки с НПЗ
estimated_i_j_k_l_fca_coeff(1 from R)(n) = for_each_element(estimated_i_j_k_l_fca(1 from R)(n), safe_divide, RAIL_ROAD_MIN_TONNAGE)
    where
        estimated_i_j_k_l_fca_coeff(1 from R)(n)(i, j, k, l) of number
        estimated_i_j_k_l_fca(1 from R)(n)(i, j, k, l)       of number
        RAIL_ROAD_MIN_TONNAGE                                of number
        estimated_i_j_k_l_fca_coeff(1 from R)(n) of matrix(Product, Refinery, Region, Market_participant)
        estimated_i_j_k_l_fca(1 from R)(n)       of matrix(Product, Refinery, Region, Market_participant)
        safe_divide from operation
            where
                n  of          index # Индекс матрицы
                Product, Refinery, Region, Market_participant from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка

# Округляем до целого числа по мат. правилам, если n = 1 (первая итерация), иначе округление вверх. Количество знаков после запятой - 0
# n-я матрица округленных коэффициентов, для расчета нормированных объемов НП l0-й очереди, для поставки с НПЗ
estimated_i_j_k_l_fca_coeff_rounded(l0)(n) = for_each_element(estimated_i_j_k_l_fca_coeff(l0)(n), round, 0)
    where
        estimated_i_j_k_l_fca_coeff(l0)(n)(i, j, k, l)         of number
        estimated_i_j_k_l_fca_coeff_rounded(l0)(n)(i, j, k, l) of number
        estimated_i_j_k_l_fca_coeff(l0)(n)         of matrix(Product, Refinery, Region, Market_participant)
        estimated_i_j_k_l_fca_coeff_rounded(l0)(n) of matrix(Product, Refinery, Region, Market_participant)
        round from operation
            where
                l0 for R  from index # Индексы очереди
                n  of          index = 1 # Индекс матрицы
                Product, Refinery, Region, Market_participant from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
estimated_i_j_k_l_fca_coeff_rounded(l0)(n) = for_each_element(estimated_i_j_k_l_fca_coeff(l0)(n), floor, 0)
    where
        estimated_i_j_k_l_fca_coeff(l0)(n)(i, j, k, l)         of number
        estimated_i_j_k_l_fca_coeff_rounded(l0)(n)(i, j, k, l) of number
        estimated_i_j_k_l_fca_coeff(l0)(n)         of matrix(Product, Refinery, Region, Market_participant)
        estimated_i_j_k_l_fca_coeff_rounded(l0)(n) of matrix(Product, Refinery, Region, Market_participant)
        floor from operation
            where
                l0 for R  from index      # Индексы очереди
                n  of          index != 1 # Индекс матрицы
                Product, Refinery, Region, Market_participant from axis
                i  for I  from index      # Индексы нефпродукта
                j  for J  from index      # Индексы НПЗ
                k  for K  from index      # Индексы региона
                l  for P  from index      # Индексы субъекта рынка

# Округляем до целого числа по мат. правилам, если n = 1 (первая итерация), иначе округление вверх. Количество знаков после запятой - 0
# n-я матрица округленных коэффициентов, для расчета нормированных объемов НП первой очереди, для поставки с НПЗ
estimated_i_j_k_l_fca_coeff_rounded(1 from R)(n) = for_each_element(estimated_i_j_k_l_fca_coeff(1 from R)(n), round, 0)
    where
        estimated_i_j_k_l_fca_coeff(1 from R)(n)(i, j, k, l)         of number
        estimated_i_j_k_l_fca_coeff_rounded(1 from R)(n)(i, j, k, l) of number
        estimated_i_j_k_l_fca_coeff(1 from R)(n)         of matrix(Product, Refinery, Region, Market_participant)
        estimated_i_j_k_l_fca_coeff_rounded(1 from R)(n) of matrix(Product, Refinery, Region, Market_participant)
        round from operation
            where
                n  of          index = 1 # Индекс матрицы
                Product, Refinery, Region, Market_participant from axis
                i  for I  from index     # Индексы нефпродукта
                j  for J  from index     # Индексы НПЗ
                k  for K  from index     # Индексы региона
                l  for P  from index     # Индексы субъекта рынка
estimated_i_j_k_l_fca_coeff_rounded(1 from R)(n) = for_each_element(estimated_i_j_k_l_fca_coeff(1 from R)(n), floor, 0)
    where
        estimated_i_j_k_l_fca_coeff(1 from R)(n)(i, j, k, l)         of number
        estimated_i_j_k_l_fca_coeff_rounded(1 from R)(n)(i, j, k, l) of number
        estimated_i_j_k_l_fca_coeff(1 from R)(n)         of matrix(Product, Refinery, Region, Market_participant)
        estimated_i_j_k_l_fca_coeff_rounded(1 from R)(n) of matrix(Product, Refinery, Region, Market_participant)
        floor from operation
            where
                n  of          index != 1 # Индекс матрицы
                Product, Refinery, Region, Market_participant from axis
                i  for I  from index      # Индексы нефпродукта
                j  for J  from index      # Индексы НПЗ
                k  for K  from index      # Индексы региона
                l  for P  from index      # Индексы субъекта рынка

estimated_i_j_k_l_fca_rounded(l0)(n) = for_each_element(estimated_i_j_k_l_fca_coeff_rounded(l0)(n), "*", RAIL_ROAD_MIN_TONNAGE)
    where
        estimated_i_j_k_l_fca_rounded(l0)(n)(i, j, k, l)       of number
        estimated_i_j_k_l_fca_coeff_rounded(l0)(n)(i, j, k, l) of number
        RAIL_ROAD_MIN_TONNAGE                                  of number
        estimated_i_j_k_l_fca_rounded(l0)(n)       of matrix(Product, Refinery, Region, Market_participant)
        estimated_i_j_k_l_fca_coeff_rounded(l0)(n) of matrix(Product, Refinery, Region, Market_participant)
        "*" from operation
            where
                l0 for R  from index # Индексы очереди
