        normalized_i_j_k_l(l0)(n)     of matrix(Product, Refinery, Region, Market_participant)
        normalized_i_j_k_l_fca(l0)(n) of matrix(Product, Refinery, Region, Market_participant)
        normalized_i_j_k_l_exw(l0)(n) of matrix(Product, Refinery, Region, Market_participant)
            where
                n  of          index # Индексы матрицы
                Product, Refinery, Region, Market_participant from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка

# n-я матрица нормированных объемов НП первой очереди: ветки FCA и EXW не пересекаются,
# у каждой группы обслуживания ровно одно выбранное условие поставки
normalized_i_j_k_l(1 from R)(n) = assign_matrix(normalized_i_j_k_l_fca(1 from R)(n), normalized_i_j_k_l_exw(1 from R)(n))
    where
        normalized_i_j_k_l(1 from R)(n)(i, j, k, l)     of number
        normalized_i_j_k_l_fca(1 from R)(n)(i, j, k, l) of number
        normalized_i_j_k_l_exw(1 from R)(n)(i, j, k, l) of number
        normalized_i_j_k_l(1 from R)(n)     of matrix(Product, Refinery, Region, Market_participant)
        normalized_i_j_k_l_fca(1 from R)(n) of matrix(Product, Refinery, Region, Market_participant)
        normalized_i_j_k_l_exw(1 from R)(n) of matrix(Product, Refinery, Region, Market_participant)
            where
                n  of          index # Индексы матрицы
                Product, Refinery, Region, Market_participant from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка

