### Предварительное итоговое распределение (нормирование)
# Нормируем (округляем) предварительные объёмы каждого Запроса (Шаг 5а) по его собственному
# условию поставки:
# — FCA (с НПЗ) — до кратности вагонной норме (по умолчанию 65 МТ) по мат. правилам, но не
#   меньше одной вагонной нормы;
# — EXW (с нефтебазы) — до кратности шагу нормы нефтебазы по мат. правилам; объём меньше
#   минимальной нормы нефтебазы получает один шаг нормы.
# Нулевые Запросы Шага 5а не нормируются и остаются с нулём.
# После контроля доли (Шаг 7) возможно повторное нормирование: первая итерация (n = 1)
# нормирует разбиение результата Шага 5, каждая следующая — разбиение урезанной матрицы
# Шага 7.2 (n + 1); на них округление идёт вниз, а минимальных норм нет.
# Шаги 7–11 работают с коллекциями (Product, Refinery, Region, Market_participant), поэтому
# нормированные объёмы Запросов в конце шага суммируются обратно по коллекциям.

# n-я матрица ненулевых предварительных объемов НП l0-й очереди по Запросам: нули Шага 5а не нормируются
estimated_i_j_x_k_l_s_l0_q_positive(l0)(n) = filter_by_value(estimated_i_j_x_k_l_s_l0_q(l0)(n), ">", 0)
    where
        estimated_i_j_x_k_l_s_l0_q(l0)(n)(i, j, x, k, l, l0, s, q)          of number
        estimated_i_j_x_k_l_s_l0_q_positive(l0)(n)(i, j, x, k, l, l0, s, q) of number
        estimated_i_j_x_k_l_s_l0_q(l0)(n)          of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        estimated_i_j_x_k_l_s_l0_q_positive(l0)(n) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        ">" from condition
            where
                n  of          index # Индекс матрицы
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

