filter_by_value   from ("matrix_operation.lang")
available_i_j_new from ("step-11.example_2.lang")

### Шаг 9. Оставшиеся объёмы позволяют удовлетворить запросы Владельцев нефтебаз/резервуаров? (пример 2)
# Остаток первой очереди v2 = available_i_j_new(1 from R) = { 10, 390, 1900 }.
# Минимальная норма для второй очереди: min(OIL_TERMINAL_MIN_TONNAGE = 4,
# RAIL_ROAD_MIN_TONNAGE = 65) = 4.

MIN_NEXT_AVAIL_TONNAGE(1 from R) = 4  # min(4, 65)
    where
        R  from index # Индексы очереди

# Доступные объёмы для второй очереди: остаток строго больше нормы (v2 > 4).
# ПКОП (J=1) проходит гейт: остаток 10 превышает норму.
# ПНХЗ (J=3) сохраняет остаток 1900: монопольный Запрос 105 распределён в первой очереди.
available_i_j(2 from R) = filter_by_value(available_i_j_new(1 from R), ">", MIN_NEXT_AVAIL_TONNAGE(1 from R)) = {
    (1 from I) = {
        (1 from I, 1 from J) =   10, #   10 > 4
        (1 from I, 2 from J) =  390, #  390 > 4
        (1 from I, 3 from J) = 1900  # 1900 > 4
    }
}
    where
        I  from index # Индексы нефпродукта
        J  from index # Индексы НПЗ

### Шаг 12. Тот же гейт при l0 = 2 (переход к III очереди — ГМК)
# Остаток после распределения Владельцам нефтебаз/резервуаров v3 = available_i_j_new(2 from R)
# = { -60, 10, 1705 } (Шаг 11). Норма та же: min(4, 65) = 4.
# Проходят АНПЗ (J=2, 10) и ПНХЗ (J=3, 1705); ПКОП (J=1) с остатком -60 выбывает (-60 <= 4) —
# Система переходит к Шагу 13.

MIN_NEXT_AVAIL_TONNAGE(2 from R) = 4  # min(4, 65)
    where
        R  from index # Индексы очереди

available_i_j(3 from R) = filter_by_value(available_i_j_new(2 from R), ">", MIN_NEXT_AVAIL_TONNAGE(2 from R)) = {
    (1 from I) = {
        (1 from I, 2 from J) =   10, #   10 > 4
        (1 from I, 3 from J) = 1705  # 1705 > 4
    }
}
    where
        I  from index # Индексы нефпродукта
        J  from index # Индексы НПЗ

### Шаг 15. Тот же гейт при l0 = 3 (переход к IV очереди — иные Субъекты рынка)
# Остаток после распределения Субъектам рынка из состава ГМК v4 = available_i_j_new(3 from R)
# = { -60, 10, 1260 } (Шаг 14). Норма та же: min(4, 65) = 4.
# Проходят АНПЗ (J=2, 10) и ПНХЗ (J=3, 1260); ПКОП (J=1) с остатком -60 выбывает (-60 <= 4) —
# Система переходит к Шагу 16. Запросов R=4 на АНПЗ в примере 2 нет, поэтому его доступный
# объём остаётся нераспределённым: IV очередь обслуживается только с ПНХЗ.

MIN_NEXT_AVAIL_TONNAGE(3 from R) = 4  # min(4, 65)
    where
        R  from index # Индексы очереди

available_i_j(4 from R) = filter_by_value(available_i_j_new(3 from R), ">", MIN_NEXT_AVAIL_TONNAGE(3 from R)) = {
    (1 from I) = {
        (1 from I, 2 from J) =   10, #   10 > 4
        (1 from I, 3 from J) = 1260  # 1260 > 4
    }
}
    where
        I  from index # Индексы нефпродукта
        J  from index # Индексы НПЗ
