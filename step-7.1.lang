normalized_i_j_k_l_s from ("step-6.lang")
sum_by_axes          from ("matrix_operation.lang")

#### Суммарный нормированный объем НП в разрезе НПЗ
# Суммируем нормированные предоставленные объёмы, сохраняя ось НПЗ:
# — по каждому Субъекту рынка с каждого НПЗ (s_ijl),
# — по всем Субъектам рынка с каждого НПЗ (итог по НПЗ, S_ij).

# n-я матрица суммарных нормированных объемов НП первой очереди,
# предоставленных каждому Субъекту рынка с каждого НПЗ
# Шаги 7-8 применяются только к реальной I очереди; виртуальные II и III очереди распределяются в Шагах 4-6 (step-10/step-13) и сюда не попадают
normalized_i_j_l(1 from R)(n) = sum_by_axes(normalized_i_j_k_l_s(1 from R)(n), Region, Ship_terms)
    where
        normalized_i_j_k_l_s(1 from R)(n)(i, l, s, j, k) of number
        normalized_i_j_l(1 from R)(n)(i, j, l)           of number
        normalized_i_j_k_l_s(1 from R)(n) of matrix(Product, Market_participant, Ship_terms, Refinery, Region)
        normalized_i_j_l(1 from R)(n)     of matrix(Product, Refinery, Market_participant)
            where
                n  of          index # Индекс матрицы
                Product, Market_participant, Ship_terms, Refinery, Region from axis
                i  for I  from index # Индексы нефпродукта
                l  for P  from index # Индексы субъекта рынка
                s  for C  from index # Индексы условия поставки
                j  for J  from index # Индексы НПЗ
                k  for K  from index # Индексы региона

# n-я матрица суммарных нормированных объемов НП первой очереди,
# предоставленных всем Субъектам рынка с каждого НПЗ
normalized_i_j(1 from R)(n) = sum_by_axes(normalized_i_j_l(1 from R)(n), Market_participant)
    where
        normalized_i_j_l(1 from R)(n)(i, j, l) of number
        normalized_i_j(1 from R)(n)(i, j)      of number
        normalized_i_j_l(1 from R)(n) of matrix(Product, Refinery, Market_participant)
        normalized_i_j(1 from R)(n)   of matrix(Product, Refinery)
            where
                n  of          index # Индекс матрицы
                Product, Refinery, Market_participant from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                l  for P  from index # Индексы субъекта рынка

