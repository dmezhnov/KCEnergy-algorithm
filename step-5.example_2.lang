                (1 from I, 2 from C, 1 from J, 5 from K) = {
                    (1 from I, 2 from C, 1 from J, 5 from K, 1  from P) = 90,                    # 103
                    (1 from I, 2 from C, 1 from J, 5 from K, 3  from P) = 100                    # 107
                }
            }
        }
    }
}
    where
        C from index # Индексы условий поставки
        I from index # Индексы нефпродукта
        J from index # Индексы НПЗ
        K from index # Индексы региона
        P from index # Индексы субъекта рынка

# Скорректированные объёмы субъектов первой очереди без превышения (НПЗ j=2, j=3).
