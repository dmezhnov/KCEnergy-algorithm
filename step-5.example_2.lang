### Предварительный расчетный объем НП (для Владельцев АЗС)
# Понижающий коэффициент применяется ТОЛЬКО для НПЗ в Периоде дефицита (Шаг 2) И только когда
# итоговый суммарный объём Запросов превышает доступный объём. В остальных случаях (Период
# профицита либо отсутствие превышения) Запросы удовлетворяются в полном объёме.

# Скорректированные Запросы первой очереди для дефицитных НПЗ (ПКОП J=1, АНПЗ J=2).
requests_i_j_corrected_deficit(1 from R) = filter_by_pair(requests_i_j_corrected(1 from R), contains, requests_i_j_deficit) = {
    (1 from I) = {
        (1 from I, 1 from J) = 1391.829268292682926829,  # 101 + 102 + 103 + 106 + 107 + 108 + 109 + 110
        (1 from I, 2 from J) = 109.268292682926829268    # 104 + 111 + 112 + 113
    }
}
    where
        I from index # Индексы нефпродукта
        J from index # Индексы НПЗ
        R from index # Индексы очереди

# Скорректированные Запросы первой очереди для профицитных НПЗ (ПНХЗ J=3).
requests_i_j_corrected_surplus(1 from R) = filter_by_pair(requests_i_j_corrected(1 from R), contains, requests_i_j_surplus) = {
    (1 from I) = {
        (1 from I, 3 from J) = 600  # 105
    }
}
    where
        I from index # Индексы нефпродукта
        J from index # Индексы НПЗ
        R from index # Индексы очереди

# Запросы дефицитных НПЗ первой очереди, превышающие доступный объём (ПКОП J=1).
requests_i_j_corrected_exceed(1 from R) = filter_by_pair(requests_i_j_corrected_deficit(1 from R), ">", available_i_j(1 from R)) = {
    (1 from I) = {
        (1 from I, 1 from J) = 1391.829268292682926829  # 1200 < 1391.829268292682926829 -> 101 + 102 + 103 + 106 + 107 + 108 + 109 + 110
