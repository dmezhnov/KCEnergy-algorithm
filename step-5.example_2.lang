### Предварительный расчетный объем НП (для Владельцев АЗС)
# Если итоговый суммарный объём Запросов на НПЗ превышает доступный объём,
# распределяем доступное пропорционально скорректированным запросам (дефицит).
# Иначе удовлетворяем запросы в полном объёме (профицит/достаточность).

# Итоговые объёмы Запросов первой очереди, которые превышают доступный объём.
requests_i_j_corrected_exceed.First = filter_by_pair(requests_i_j_corrected.First, ">", available_i_j.First) = {
    (1 from I) = {
        (1 from I, 1 from J) = 1391.829268292682926829  # 1200 < 1391.829268292682926829 -> 101 + 102 + 103 + 106 + 107 + 108 + 109 + 110
    }
}
    where
        I from index # Индексы нефпродукта
        J from index # Индексы НПЗ

# Итоговые объёмы Запросов первой очереди, которые не превышают доступный объём.
requests_i_j_corrected_not_exceed.First = filter_by_pair(requests_i_j_corrected.First, "<=", available_i_j.First) = {
    (1 from I) = {
        (1 from I, 2 from J) = 109.268292682926829268,  # 500 > 109.268292682926829268 -> 104 + 111 + 112 + 113
        (1 from I, 3 from J) = 600                      # 2500 > 600 -> 105
    }
}
    where
        I from index # Индексы нефпродукта
        J from index # Индексы НПЗ

# Скорректированные объёмы субъектов первой очереди, попавшие в превышение (НПЗ j=1).
requests_i_j_k_l_s_corrected_exceed.First = filter_by_pair(requests_i_j_k_l_s_corrected.First, contains, requests_i_j_corrected_exceed.First) = {
    (1 from I) = {
        (1 from I, 1 from C) = {
            (1 from I, 1 from C, 1 from J) = {
                (1 from I, 1 from C, 1 from J, 3 from K) = {
                    (1 from I, 1 from C, 1 from J, 3 from K, 2  from P) = 715                    # 106
                },
                (1 from I, 1 from C, 1 from J, 4 from K) = {
                    (1 from I, 1 from C, 1 from J, 4 from K, 1  from P) = 9.512195121951219512,  # 101
                    (1 from I, 1 from C, 1 from J, 4 from K, 12 from P) = 200                    # 108
                }
            }
        },
        (1 from I, 2 from C) = {
            (1 from I, 2 from C, 1 from J) = {
                (1 from I, 2 from C, 1 from J, 1 from K) = {
                    (1 from I, 2 from C, 1 from J, 1 from K, 7  from P) = 70                     # 110
                },
                (1 from I, 2 from C, 1 from J, 4 from K) = {
                    (1 from I, 2 from C, 1 from J, 4 from K, 1  from P) = 7.317073170731707317,  # 102
                    (1 from I, 2 from C, 1 from J, 4 from K, 13 from P) = 200                    # 109
