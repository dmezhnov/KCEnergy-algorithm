        (1 from I, 3 from J) = 195  # 105 + 201 + 202
    }
}
    where
        I from index # Индексы нефпродукта
        J from index # Индексы НПЗ
        R from index # Индексы очереди

# Запросы дефицитных НПЗ II очереди, превышающие доступный объём (АНПЗ J=2; ПКОП без ячейки available).
requests_i_j_corrected_exceed(2 from R) = filter_by_pair(requests_i_j_corrected_deficit(2 from R), ">", available_i_j(2 from R)) = {
    (1 from I) = {
        (1 from I, 2 from J) = 920  # 920 > 390 -> 104 + 111 + 112 + 113 + 205 + 206 + 207 + 208 + 209
