# Доля доступного объёма от запрошенного для превышенных НПЗ первой очереди.
estimated_i_j_exceed_share.First = for_each_pair(available_i_j.First, safe_divide, requests_i_j_corrected_exceed.First) = {
    (1 from I) = {
        (1 from I, 1 from J) = 1200 / 1391.829268292682926829 = 0.862174713046525891
    }
}
    where
        I from index # Индексы нефпродукта
        J from index # Индексы НПЗ

# Предварительный объём НП для превышенных НПЗ: запрос, умноженный на долю.
