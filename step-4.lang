### Итоговый суммарный объем Запросов (после корректировок в дефиците)

# В остальных случаях (очереди > 1) корректировки на проливы нет: берём исходные объёмы (r_ijkl)
requests_i_j_k_l_s_corrected(l0) = sum_by_axes(requests_i_j_x_k_l_s(l0), Terminal)
    where
        l0 > 1 # Если это не первая очередь
        requests_i_j_k_l_s_corrected(l0)(i, j, s, l, k)    of number
        requests_i_j_x_k_l_s(l0)(i, j, s, l, k, x)         of number
        requests_i_j_k_l_s_corrected(l0) of matrix(Product, Refinery, Ship_terms, Market_participant, Region)
        requests_i_j_x_k_l_s(l0)         of matrix(Product, Refinery, Ship_terms, Market_participant, Region, Terminal)
            where
                l0 for R  from index # Индексы очереди
                Product, Refinery, Ship_terms, Market_participant, Region, Terminal from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                s  for C  from index # Индексы условия поставки
                l  for P  from index # Индексы субъекта рынка
                k  for K  from index # Индексы региона
                x  for X  from index # Индексы нефтебаз

# Для первой очереди берём скорректированный на проливы объём (Шаг 3:S, Таблица 68) — r°_ijkl
