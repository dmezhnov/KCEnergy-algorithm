### Шаг 8. Оставшийся после распределения Владельцам АЗС объём НП (пример 1)
# Остатки по (Product, Refinery) после распределения первой очереди (Владельцы АЗС):
# доступный объём v0 минус суммарно предоставленный Владельцам АЗС (свёртка s̈ по k, l, s).
# Цикл нормирования первой очереди сошёлся на n = 1, поэтому последняя принятая матрица
# предварительных расчётных объёмов совпадает с нормированной матрицей Шага 6.

# Последняя матрица предварительных расчётных объёмов НП первой очереди (s̈).
estimated_i_j_k_l_s_last(1 from R) = estimated_i_j_k_l_s(1 from R)(last_n) = {
    (1 from C) = {
        (1 from C, 1 from I) = {
            (1 from C, 1 from I, 1 from J) = {
                (1 from C, 1 from I, 1 from J, 3 from K) = {
                    (1 from C, 1 from I, 1 from J, 3 from K, 2  from P) = 585  # 106
                },
                (1 from C, 1 from I, 1 from J, 4 from K) = {
                    (1 from C, 1 from I, 1 from J, 4 from K, 1  from P) = 65,  # 101
                    (1 from C, 1 from I, 1 from J, 4 from K, 12 from P) = 195  # 108
                }
            }
        }
    },
    (2 from C) = {
        (2 from C, 1 from I) = {
            (2 from C, 1 from I, 1 from J) = {
                (2 from C, 1 from I, 1 from J, 1 from K) = {
                    (2 from C, 1 from I, 1 from J, 1 from K, 7  from P) = 55   # 110
                },
                (2 from C, 1 from I, 1 from J, 4 from K) = {
                    (2 from C, 1 from I, 1 from J, 4 from K, 1  from P) = 30,  # 102
                    (2 from C, 1 from I, 1 from J, 4 from K, 13 from P) = 165  # 109
                },
                (2 from C, 1 from I, 1 from J, 5 from K) = {
                    (2 from C, 1 from I, 1 from J, 5 from K, 1  from P) = 75,  # 103
                    (2 from C, 1 from I, 1 from J, 5 from K, 3  from P) = 80   # 107
                }
            },
            (2 from C, 1 from I, 2 from J) = {
                (2 from C, 1 from I, 2 from J, 4 from K) = {
                    (2 from C, 1 from I, 2 from J, 4 from K, 7  from P) = 30,  # 111
                    (2 from C, 1 from I, 2 from J, 4 from K, 18 from P) = 30,  # 112
                    (2 from C, 1 from I, 2 from J, 4 from K, 19 from P) = 20   # 113
                }
            }
        }
    }
}
    where
        estimated_i_j_k_l_s_last(1 from R)(i, l, j, k, s)    of number
        estimated_i_j_k_l_s(1 from R)(last_n)(i, l, j, k, s) of number
        estimated_i_j_k_l_s(1 from R)      of matrix(Product, Refinery, Market_participant, Region, Ship_terms)
        estimated_i_j_k_l_s_last(1 from R) of matrix(Product, Refinery, Market_participant, Region, Ship_terms)
            where
                last_n    of   index = length(estimated_i_j_k_l_s(1 from R)) # индекс последней матрицы предварительных расчётных объёмов НП
                Product, Market_participant, Refinery, Region, Ship_terms from axis
                i  for I  from index # Индексы нефпродукта
                l  for P  from index # Индексы субъекта рынка
                j  for J  from index # Индексы НПЗ
                k  for K  from index # Индексы региона
                s  for C  from index # Индексы условия поставки

# Суммарно предоставленный Владельцам АЗС объём по НПЗ (свёртка s̈ по региону, субъекту, условию).
estimated_i_j_last(1 from R) = sum_by_axes(estimated_i_j_k_l_s_last(1 from R), Region, Market_participant, Ship_terms) = {
    (1 from I) = {
        (1 from I, 1 from J) =  65 +  30 +  75 + 585 +  80 + 195 + 165 +  55 = 1250,  # 101 + 102 + 103 + 106 + 107 + 108 + 109 + 110
        (1 from I, 2 from J) =                                30 +  30 +  20 =   80   # 111 + 112 + 113
    }
}
    where
        estimated_i_j_k_l_s_last(1 from R)(i, j, s, l, k) of number
        estimated_i_j_last(1 from R)(i, j)                of number
        estimated_i_j_k_l_s_last(1 from R) of matrix(Product, Refinery, Ship_terms, Market_participant, Region)
        estimated_i_j_last(1 from R)       of matrix(Product, Refinery)
            where
                Product, Market_participant, Ship_terms, Refinery, Region from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                s  for C  from index # Индексы условия поставки
                l  for P  from index # Индексы субъекта рынка
                k  for K  from index # Индексы региона

# Матрица оставшихся после распределения Владельцам АЗС объёмов НП первой очереди (v2 = v0 - s̈).
# По ПНХЗ распределения первой очереди не было, поэтому остаток равен доступному объёму.
available_i_j_new(1 from R) = for_each_pair(available_i_j(1 from R), "-", estimated_i_j_last(1 from R)) = {
    (1 from I) = {
        (1 from I, 1 from J) = 1200 - 1250 =  -50,
        (1 from I, 2 from J) =  500 -   80 =  420,
        (1 from I, 3 from J) = 2500 -    0 = 2500
    }
}
    where
        available_i_j_new(1 from R)(i, j)  of number
        available_i_j(1 from R)(i, j)      of number
        estimated_i_j_last(1 from R)(i, j) of number
        available_i_j_new(1 from R)  of matrix(Product, Refinery)
        available_i_j(1 from R)      of matrix(Product, Refinery)
        estimated_i_j_last(1 from R) of matrix(Product, Refinery)
        "-" from operation
            where
                Product, Refinery from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ

