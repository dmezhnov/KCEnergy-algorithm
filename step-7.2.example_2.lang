# Урезанных групп нет, поэтому пусто и их разбиение по числу условий поставки, и всё нормирование ниже.
normalized_i_j_k_l_corrected_single(1 from R)(1 from n) = filter_by_pair(normalized_i_j_k_l_corrected(1 from R)(1 from n), contains, filter_by_coordinate(ship_terms_count_by_requests_l0_single, First)) = {}
