MAX_SUBJECT_SHARE_COEFFICIENT                                                    from ("initial_data.example_2.lang")
RAIL_ROAD_MIN_TONNAGE, OIL_TERMINAL_MIN_TONNAGE, OIL_TERMINAL_STEP_TONNAGE       from ("initial_data.example_2.lang")
requests_i_j_k_l_s_l0                                                            from ("step-minus-1.example_2.lang")
