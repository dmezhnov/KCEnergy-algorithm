# Ограниченные предельным порогом объёмы — пусто.
normalized_i_j_k_l_limited(1 from R)(1 from n) = for_each_pair(normalized_i_j_k_l_increased(1 from R)(1 from n), "*", normalized_i_j_threshold(1 from R)(1 from n)) = {}
