MAX_SUBJECT_SHARE_COEFFICIENT   from ("initial_data.example_2.lang")
normalized_i_j_k_l_s            from ("step-6.example_2.lang")
normalized_i_j_l, normalized_i_j from ("step-7.1.example_2.lang")

### Шаг 7.2. Уточнение нормированных объёмов НП первой очереди по предельной доле
# Сравниваем долю каждого Субъекта рынка на каждом НПЗ с предельной долей
# (δ × Ṡ_ij, δ = 50%). Если доля субъекта превышает предел, его объёмы
# понижаются и матрица перенормируется (возврат к Шагу 6); иначе расчёт сходится.

# Предельный объём на одного Субъекта рынка на каждом НПЗ (порог δ × Ṡ_ij):
# умножаем итог по НПЗ (Ṡ_ij) на предельную долю δ = 0.5.
normalized_i_j_threshold.First(1 from n) = for_each_element(normalized_i_j.First(1 from n), "*", MAX_SUBJECT_SHARE_COEFFICIENT) = {
    (1 from I) = {
        (1 from I, 1 from J) = 1245 * MAX_SUBJECT_SHARE_COEFFICIENT = 1245 * 0.5 = 622.5,
        (1 from I, 2 from J) =  110 * MAX_SUBJECT_SHARE_COEFFICIENT =  110 * 0.5 =    55,
        (1 from I, 3 from J) =  600 * MAX_SUBJECT_SHARE_COEFFICIENT =  600 * 0.5 =   300
    }
}
    where
        n  of   index # Индекс матрицы
        I  from index # Индексы нефпродукта
        J  from index # Индексы НПЗ

# Субъекты рынка, чья доля превышает предел (s̈_ijl > δ × Ṡ_ij):
# (1, 3) порог  300: P1 = 600 > 300 — превышает (доля 100%);
# (1, 1) порог 622.5: P2 = 585, P12 = 195, P13 = 170, P1 = 150, P3 = 85, P7 = 60 — все <= 622.5;
# (1, 2) порог   55: P1 = 30, P7 = 30, P18 = 30, P19 = 20 — все <= 55.
normalized_i_j_l_increased.First(1 from n) = filter_by_pair(normalized_i_j_l.First(1 from n), ">", normalized_i_j_threshold.First(1 from n)) = {
    (1 from I) = {
        (1 from I, 3 from J) = {
            (1 from I, 3 from J, 1 from P) = 600  # 105
        }
    }
}
    where
        n  of   index # Индекс матрицы
        I  from index # Индексы нефпродукта
        J  from index # Индексы НПЗ
        P  from index # Индексы субъекта рынка

# Записи исходной матрицы для превысившего субъекта (P1 на НПЗ-3).
normalized_i_j_k_l_s_increased.First(1 from n) = filter_by_pair(normalized_i_j_k_l_s.First(1 from n), contains, normalized_i_j_l_increased.First(1 from n)) = {
    (2 from C) = {
        (2 from C, 1 from I) = {
            (2 from C, 1 from I, 3 from J) = {
                (2 from C, 1 from I, 3 from J, 4 from K) = {
                    (2 from C, 1 from I, 3 from J, 4 from K, 1 from P) = 600  # 105
                }
            }
        }
    }
}
    where
        n  of   index # Индекс матрицы
        C  from index # Индексы условия поставки
        I  from index # Индексы нефпродукта
        J  from index # Индексы НПЗ
        K  from index # Индексы региона
        P  from index # Индексы субъекта рынка

# Ограниченные предельным порогом объёмы: s⃛ × (δ × Ṡ_ij).
normalized_i_j_k_l_s_limited.First(1 from n) = for_each_pair(normalized_i_j_k_l_s_increased.First(1 from n), "*", normalized_i_j_threshold.First(1 from n)) = {
    (2 from C) = {
        (2 from C, 1 from I) = {
            (2 from C, 1 from I, 3 from J) = {
                (2 from C, 1 from I, 3 from J, 4 from K) = {
                    (2 from C, 1 from I, 3 from J, 4 from K, 1 from P) = 600 * 300 = 180000  # 105
                }
            }
        }
    }
}
    where
        n  of   index # Индекс матрицы
        C  from index # Индексы условия поставки
        I  from index # Индексы нефпродукта
        J  from index # Индексы НПЗ
        K  from index # Индексы региона
        P  from index # Индексы субъекта рынка

# Скорректированные объёмы s⃛ × (δ × Ṡ_ij) / s̈_ijl: доля субъекта понижается до предела.
normalized_i_j_k_l_s_corrected.First(1 from n) = for_each_pair(normalized_i_j_k_l_s_limited.First(1 from n), "/", normalized_i_j_l.First(1 from n)) = {
    (2 from C) = {
        (2 from C, 1 from I) = {
            (2 from C, 1 from I, 3 from J) = {
                (2 from C, 1 from I, 3 from J, 4 from K) = {
                    (2 from C, 1 from I, 3 from J, 4 from K, 1 from P) = 180000 / 600 = 300  # 105
                }
            }
        }
    }
}
    where
        n  of   index # Индекс матрицы
        C  from index # Индексы условия поставки
        I  from index # Индексы нефпродукта
        J  from index # Индексы НПЗ
        K  from index # Индексы региона
        P  from index # Индексы субъекта рынка

# Набор коррекций не пуст, поэтому матрица перенормируется (возврат к Шагу 6):
# объём субъекта P1 на НПЗ-3 понижается с 600 до 300 (предел 50%), остальные без изменений.
estimated_i_j_k_l_s.First(2 from n) = assign_matrix(normalized_i_j_k_l_s.First(1 from n), normalized_i_j_k_l_s_corrected.First(1 from n)) = {
    (1 from C) = {
        (1 from C, 1 from I) = {
            (1 from C, 1 from I, 1 from J) = {
                (1 from C, 1 from I, 1 from J, 3 from K) = {
                    (1 from C, 1 from I, 1 from J, 3 from K, 2  from P) = 585  # 106
                },
                (1 from C, 1 from I, 1 from J, 4 from K) = {
                    (1 from C, 1 from I, 1 from J, 4 from K, 1  from P) = 65,  # 101
                    (1 from C, 1 from I, 1 from J, 4 from K, 12 from P) = 195  # 108
                }
            }
        }
    },
    (2 from C) = {
        (2 from C, 1 from I) = {
            (2 from C, 1 from I, 1 from J) = {
                (2 from C, 1 from I, 1 from J, 1 from K) = {
                    (2 from C, 1 from I, 1 from J, 1 from K, 7  from P) = 60   # 110
                },
                (2 from C, 1 from I, 1 from J, 4 from K) = {
                    (2 from C, 1 from I, 1 from J, 4 from K, 1  from P) = 5,   # 102
                    (2 from C, 1 from I, 1 from J, 4 from K, 13 from P) = 170  # 109
                },
                (2 from C, 1 from I, 1 from J, 5 from K) = {
                    (2 from C, 1 from I, 1 from J, 5 from K, 1  from P) = 80,  # 103
                    (2 from C, 1 from I, 1 from J, 5 from K, 3  from P) = 85   # 107
                }
            },
            (2 from C, 1 from I, 2 from J) = {
                (2 from C, 1 from I, 2 from J, 4 from K) = {
                    (2 from C, 1 from I, 2 from J, 4 from K, 1  from P) = 30,  # 104
                    (2 from C, 1 from I, 2 from J, 4 from K, 7  from P) = 30,  # 111
                    (2 from C, 1 from I, 2 from J, 4 from K, 18 from P) = 30,  # 112
                    (2 from C, 1 from I, 2 from J, 4 from K, 19 from P) = 20   # 113
                }
            },
            (2 from C, 1 from I, 3 from J) = {
                (2 from C, 1 from I, 3 from J, 4 from K) = {
                    (2 from C, 1 from I, 3 from J, 4 from K, 1  from P) = 300  # 105 (понижено с 600)
                }
            }
        }
    }
}
    where
        is_empty( normalized_i_j_k_l_s_corrected.First(1 from n) ) = false
            where
                n  of   index # Индекс матрицы
                C  from index # Индексы условия поставки
                I  from index # Индексы нефпродукта
                J  from index # Индексы НПЗ
                K  from index # Индексы региона
                P  from index # Индексы субъекта рынка
