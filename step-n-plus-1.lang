length, number                 from core
requests_i_j_x_k_l_s_l0_q      from ("initial_data.lang")
estimated_i_j_x_k_l_s_l0_q     from ("step-5a.lang")
estimated_i_j_k_l              from ("step-7.2.lang")
normalized_i_j_x_k_l_s_l0_q    from ("step-6.lang")
axis, index, matrix            from ("matrix_types.lang")
assign_matrix, sum_by_axes     from ("matrix_operation.lang")
requests_i_j_k_l_l0            from ("step-minus-1.lang")

### Дополнительный шаг алгоритма (Шаг N + 1)
# Сборка итога: объём по каждому фактически поданному Запросу уже посчитан по очередям —
# Шаг 5а разложил объём коллекции по её Запросам, Шаг 6 нормировал каждый Запрос по его
# условию поставки. Шаг (N + 1) только собирает эти матрицы всех очередей в одну.
# Номер Запроса уникален во всех очередях, поэтому матрицы очередей не пересекаются.

# Нормированные объёмы по Запросам I очереди — последняя итерация цикла Шагов 6-7.2,
# та же, что Шаг 8 берёт для коллекций. Последний член estimated_i_j_k_l — пустая
# матрица, которой Шаг 7.2 завершает цикл, поэтому last_n на единицу меньше его длины.
requests_i_j_x_k_l_s_l0_q_allocated(1 from R) = normalized_i_j_x_k_l_s_l0_q(1 from R)(last_n)
    where
        normalized_i_j_x_k_l_s_l0_q(1 from R)(last_n)(i, j, x, k, l, l0, s, q) of number
        requests_i_j_x_k_l_s_l0_q_allocated(1 from R)(i, j, x, k, l, l0, s, q) of number
        estimated_i_j_k_l(1 from R)                   of matrix(Product, Refinery, Region, Market_participant)
        normalized_i_j_x_k_l_s_l0_q(1 from R)(last_n) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_i_j_x_k_l_s_l0_q_allocated(1 from R) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
            where
                last_n of index = length(estimated_i_j_k_l(1 from R)) - 1 # Индекс последней итерации нормирования
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# Нормированные объёмы по Запросам II очереди и далее: цикла Шагов 6-7.2 у них нет,
# единственная итерация нормирования — первая.
requests_i_j_x_k_l_s_l0_q_allocated(l0) = normalized_i_j_x_k_l_s_l0_q(l0)(1)
    where
        l0 > 1 # Очереди II и далее; I очередь задана как (1 from R) выше
        normalized_i_j_x_k_l_s_l0_q(l0)(1)(i, j, x, k, l, l0, s, q)      of number
        requests_i_j_x_k_l_s_l0_q_allocated(l0)(i, j, x, k, l, l0, s, q) of number
        normalized_i_j_x_k_l_s_l0_q(l0)(1)      of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_i_j_x_k_l_s_l0_q_allocated(l0) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
            where
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# Итог Шага (N + 1): объём, предоставленный по каждому фактически поданному Запросу.
# Запрос, которому не досталось объёма, уже стоит в матрице своей очереди с нулём (Шаги 5а и 6
# возвращают нулевые Запросы), поэтому отдельная нулевая база не нужна.
requests_i_j_x_k_l_s_l0_q_final = assign_matrix(requests_i_j_x_k_l_s_l0_q_allocated(1), ..., requests_i_j_x_k_l_s_l0_q_allocated(L0))
    where
        requests_i_j_x_k_l_s_l0_q_allocated(l0)(i, j, x, k, l, l0, s, q) of number
        requests_i_j_x_k_l_s_l0_q_final(i, j, x, k, l, l0, s, q)         of number # Предоставленный объем НП
        requests_i_j_x_k_l_s_l0_q_allocated(l0) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_i_j_x_k_l_s_l0_q_final         of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
            where
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов
                L0        from index # Количество очередей

# Запрошенный субъектом рынка объём вида НП в регион на всех НПЗ, по очередям
# (строка «из запрошенных» итога трассировки)
requests_i_k_l_l0 = sum_by_axes(requests_i_j_k_l_l0, Refinery)
    where
        requests_i_j_k_l_l0(i, j, k, l, l0) of number # Запрашиваемый объем НП
        requests_i_k_l_l0(i, k, l, l0)      of number # Запрашиваемый объем НП на всех НПЗ
        requests_i_j_k_l_l0 of matrix(Product, Refinery, Region, Market_participant, Queue)
        requests_i_k_l_l0   of matrix(Product, Region, Market_participant, Queue)
        Product, Refinery, Region, Market_participant, Queue from axis # Оси
            where
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди

# Предоставленный субъекту рынка объём вида НП в регион на всех НПЗ, по очередям
# (строка «Всего» итога трассировки)
requests_i_k_l_l0_final = sum_by_axes(requests_i_j_x_k_l_s_l0_q_final, Refinery, Terminal, Ship_terms, Request)
    where
        requests_i_j_x_k_l_s_l0_q_final(i, j, x, k, l, l0, s, q) of number # Предоставленный объем НП
        requests_i_k_l_l0_final(i, k, l, l0)                     of number # Предоставленный объем НП на всех НПЗ
        requests_i_j_x_k_l_s_l0_q_final of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_i_k_l_l0_final         of matrix(Product, Region, Market_participant, Queue)
        Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
            where
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# Запрошенный объём по каждому Запросу без оси нефтебаз: у Запроса одна нефтебаза, поэтому
# сумма ничего не сливает (списки Запросов Шага (-1) и Шага 5а трассировочной строки)
requests_i_j_k_l_s_l0_q = sum_by_axes(requests_i_j_x_k_l_s_l0_q, Terminal)
    where
        requests_i_j_x_k_l_s_l0_q(i, j, x, k, l, l0, s, q) of number # Запрашиваемый объем НП
        requests_i_j_k_l_s_l0_q(i, j, k, l, l0, s, q)      of number # Запрашиваемый объем НП по Запросу
        requests_i_j_x_k_l_s_l0_q of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_i_j_k_l_s_l0_q   of matrix(Product, Refinery, Region, Market_participant, Queue, Ship_terms, Request)
        Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
            where
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# n-я матрица предварительных объёмов l0-й очереди по Запросам без оси нефтебаз
# (списки Запросов Шагов 5а и 6 трассировочной строки)
estimated_i_j_k_l_s_l0_q(l0)(n) = sum_by_axes(estimated_i_j_x_k_l_s_l0_q(l0)(n), Terminal)
    where
        estimated_i_j_x_k_l_s_l0_q(l0)(n)(i, j, x, k, l, l0, s, q) of number
        estimated_i_j_k_l_s_l0_q(l0)(n)(i, j, k, l, l0, s, q)      of number
        estimated_i_j_x_k_l_s_l0_q(l0)(n) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        estimated_i_j_k_l_s_l0_q(l0)(n)   of matrix(Product, Refinery, Region, Market_participant, Queue, Ship_terms, Request)
            where
                n  of          index # Индекс матрицы
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# n-я матрица нормированных объёмов l0-й очереди по Запросам без оси нефтебаз
# (список Запросов Шага 6 трассировочной строки)
normalized_i_j_k_l_s_l0_q(l0)(n) = sum_by_axes(normalized_i_j_x_k_l_s_l0_q(l0)(n), Terminal)
    where
        normalized_i_j_x_k_l_s_l0_q(l0)(n)(i, j, x, k, l, l0, s, q) of number
        normalized_i_j_k_l_s_l0_q(l0)(n)(i, j, k, l, l0, s, q)      of number
        normalized_i_j_x_k_l_s_l0_q(l0)(n) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        normalized_i_j_k_l_s_l0_q(l0)(n)   of matrix(Product, Refinery, Region, Market_participant, Queue, Ship_terms, Request)
            where
                n  of          index # Индекс матрицы
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# Предоставленный объём по каждому Запросу без осей нефтебаз и условий поставки: у Запроса
# одна нефтебаза и одно условие поставки (список «Итого» трассировочной строки)
requests_i_j_k_l_l0_q_final = sum_by_axes(requests_i_j_x_k_l_s_l0_q_final, Terminal, Ship_terms)
    where
        requests_i_j_x_k_l_s_l0_q_final(i, j, x, k, l, l0, s, q) of number # Предоставленный объем НП
        requests_i_j_k_l_l0_q_final(i, j, k, l, l0, q)           of number # Предоставленный объем НП по Запросу
        requests_i_j_x_k_l_s_l0_q_final of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_i_j_k_l_l0_q_final     of matrix(Product, Refinery, Region, Market_participant, Queue, Request)
        Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
            where
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

## Трассировочная строка для запроса № Request(q):
# Шаг (-1).
# Запросы Субъекта с одинаковыми параметрами:
#         Очередь - $Queue(l0)
#         Вид НП  - $Product(i)
#         НПЗ     - $Refinery(j)
#         Регион  - $Region(k)
# Запросы Субъекта до агрегирования:
#         ($Refinery(j)  $Request(1) -> requests_i_j_k_l_s_l0_q(i, j, k, l, l0, 1, 1) МТ,
#          ...,
#          $Refinery(j)  $Request(D) -> requests_i_j_k_l_s_l0_q(i, j, k, l, l0, 1, D) МТ),
#         ...,
#         ($Refinery(j)  $Request(1) -> requests_i_j_k_l_s_l0_q(i, j, k, l, l0, S, 1) МТ,
#          ...,
#          $Refinery(j)  $Request(D) -> requests_i_j_k_l_s_l0_q(i, j, k, l, l0, S, D) МТ)
# Запрос Субъекта после агрегирования:
#         $Refinery(j)  (($Request(1) -> requests_i_j_k_l_s_l0_q(i, j, k, l, l0, 1, 1), ..., $Request(D) -> requests_i_j_k_l_s_l0_q(i, j, k, l, l0, 1, D)), ..., ($Request(1) -> requests_i_j_k_l_s_l0_q(i, j, k, l, l0, S, 1), ..., $Request(D) -> requests_i_j_k_l_s_l0_q(i, j, k, l, l0, S, D))) = requests_i_j_k_l_l0(i, j, k, l, l0) МТ
#
# Шаг 1. Объем запросов от всех субъектов по $Product(i) на $Refinery(j)
#        в объеме: $requests_i_j(i, j) МТ.
#
# Шаг 2. На $Refinery(j) по $Product(i) доступно {if: requests_i_j(i, j) >= threshold_i_j(i, j)}{then: available_i_j_deficit(i, j)}{else: available_i_j_surplus(i, j)} МТ.
#        Установлен Период {if: requests_i_j(i, j) >= threshold_i_j(i, j)}{then: дефицита}{else: профицита}.
#
# {if: l0 = 1}{
# then:
#     Шаг 3.1. Средний пролив $Product(i) Субъекта в $Region(k): moving_average(l, i, k) МТ.
#
#     {if: requests_i_j(i, j) >= threshold_i_j(i, j)}{
#     then:
#         {if: refinery_count_by_deficit_requests(i, k, l) > 1}{
#         then:
#             Шаг 3.2. Количество дефицитных НПЗ refinery_count_by_deficit_requests(i, k, l) > 1, переходим к Шагу 3.2.2.
#
#             Шаг 3.2.2. Пролив, приходящийся на $Refinery(j): requests_i_j_k_l_corrected(i, k, l, j) МТ.
#                        Субъект подал Запросы с теми же параметрами
#                        ($Product(i), $Region(k)) на refinery_count_by_requests_multiple(i, k, l) НПЗ:
#                          $Refinery(1)  (($Request(1) -> requests_i_j_k_l_s_l0_q(i, 1, k, l, 1 from R, 1, 1), ..., $Request(D) -> requests_i_j_k_l_s_l0_q(i, 1, k, l, 1 from R, 1, D)), ..., ($Request(1) -> requests_i_j_k_l_s_l0_q(i, 1, k, l, 1 from R, S, 1), ..., $Request(D) -> requests_i_j_k_l_s_l0_q(i, 1, k, l, 1 from R, S, D))) = requests_i_j_k_l_queue(1 from R)(i, 1, k, l) МТ,
#                          ...,
#                          $Refinery(M)  (($Request(1) -> requests_i_j_k_l_s_l0_q(i, M, k, l, 1 from R, 1, 1), ..., $Request(D) -> requests_i_j_k_l_s_l0_q(i, M, k, l, 1 from R, 1, D)), ..., ($Request(1) -> requests_i_j_k_l_s_l0_q(i, M, k, l, 1 from R, S, 1), ..., $Request(D) -> requests_i_j_k_l_s_l0_q(i, M, k, l, 1 from R, S, D))) = requests_i_j_k_l_queue(1 from R)(i, M, k, l) МТ
#                        Пролив делится между НПЗ пропорционально Запросам:
#                          доля $Refinery(j) = requests_i_j_k_l_deficit_multiple(i, k, l, j) / requests_i_k_l_all_multiple(i, k, l) = requests_i_j_k_l_deficit_multiple_share(i, k, l, j)
#                          moving_average(l, i, k) × requests_i_j_k_l_deficit_multiple_share(i, k, l, 1) = requests_i_j_k_l_deficit_multiple_pend_aux(i, k, l, 1) МТ — на $Refinery(1),
#                          ...,
#                          moving_average(l, i, k) × requests_i_j_k_l_deficit_multiple_share(i, k, l, M) = requests_i_j_k_l_deficit_multiple_pend_aux(i, k, l, M) МТ — на $Refinery(M)
#         }{
#         else:
#             Шаг 3.2. Количество дефицитных НПЗ refinery_count_by_deficit_requests(i, k, l) = 1, переходим к Шагу 3.2.1.
#
#             Шаг 3.2.1. Ограничение Запроса проливом при подаче на один НПЗ:
#                        requests_i_j_k_l_deficit_single_corrected(i, k, l, j) МТ.
#         }
#     }{
#     else:
#         Шаг 3.2. Не применяется: на $Refinery(j) Период профицита,
#                  Запрос учитывается полностью.
#     }
#
#     Шаг 4. Сумма Запросов всех Владельцев АЗС (I очередь) на $Refinery(j)
#            после ограничения проливами: requests_i_j_corrected(l0)(i, j) МТ.
# }{
# else:
#     Шаг 3.1. Средний пролив $Product(i) Субъекта в $Region(k): не применяется.
#
#     {if: l0 = 2}{
#     then:
#         {if: available_i_j_new(l0 - 1)(i, j) > MIN_NEXT_AVAIL_TONNAGE(l0 - 1)}{
#         then:
#             Шаг 9. Осталось доступных объемов для II очереди после I очереди:
#                    available_i_j(l0)(i, j) МТ.
#         }{
#         else:
#             Шаг 9. Осталось доступных объемов для II очереди после I очереди:
#                    0 МТ — остаток available_i_j_new(l0 - 1)(i, j) МТ не больше минимальной нормы MIN_NEXT_AVAIL_TONNAGE(l0 - 1) МТ.
#         }
#     }{
#     else if: l0 = 3}{
#     then:
#         Шаг 11. Осталось после II очереди: available_i_j_new(l0 - 1)(i, j) МТ.
#         {if: available_i_j_new(l0 - 1)(i, j) > MIN_NEXT_AVAIL_TONNAGE(l0 - 1)}{
#         then:
#             Шаг 12. Сколько $Product(i) осталось для III очереди: available_i_j(l0)(i, j) МТ.
#         }{
