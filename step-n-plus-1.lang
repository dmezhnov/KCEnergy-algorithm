length, number                                                   from core
requests_i_j_x_k_l_s_l0_q                                        from ("initial_data.lang")
estimated_i_j_k_l_last                                           from ("step-8.lang")
normalized_i_j_k_l                                               from ("step-6.lang")
axis, condition, coordinate, index, operation                    from ("matrix_types.lang")
assign_matrix, count_coordinates_by_axis, filter_by_coordinate   from ("matrix_operation.lang")
filter_by_pair, filter_by_value, for_each_element, for_each_pair from ("matrix_operation.lang")
replace_coord, sum_by_axes                                       from ("matrix_operation.lang")

### Дополнительный шаг алгоритма (Шаг N + 1)
# Шаг −1 объединил Запросы Субъекта рынка по нефтебазам (ось Terminal) и по условиям
# поставки (ось Ship_terms), поэтому весь каскад Шагов 1-16 распределяет объём на
# коллекцию (Product, Refinery, Region, Market_participant) в очереди Queue. Шаг (N + 1)
# раскладывает предоставленный коллекции объём обратно по её фактически поданным
# Запросам.
#
# Правило раскладки (сверено со всеми восемью кейсами заказчика, лист «Глазами
# алгоритма»): Запросы коллекции перебираются по УБЫВАНИЮ запрашиваемого объёма (при
# равных объёмах — в хронологическом порядке, то есть по возрастанию номера Запроса).
# Запрос наливается ЦЕЛИКОМ, если помещается в остаток, иначе отказывается — остаток
# при этом сохраняется для следующих, более мелких Запросов коллекции (кейсы 1, 4, 5, 6
# заказчика: более крупный Запрос получает 0, а не остаток).
#
# Исключение — самый мелкий Запрос коллекции: перебор заканчивается на нём, и он забирает
# весь оставшийся объём, даже если тот меньше запрашиваемого. Поэтому коллекция с
# единственным Запросом всегда получает предоставленный ей объём целиком (реальные данные
# заказчика, лист «ПКОП»: Запрос 3900 при нормированном объёме 2665 получил 2665, Запрос
# 1040 при 455 получил 455).
#
# Условие поставки Шаг (N + 1) не учитывает: выбор условия сделан в Шаге 6 выбором нормы
# (вагонная норма для FCA, норма нефтебазы для EXW), и отказ Запросам другого условия
# получается сам собой — более крупные Запросы забирают остаток первыми.
#
# Отказ показан нулём в ячейке Запроса: ячейка остаётся в матрице, а её значение равно 0.

# Итоговый объём, предоставленный коллекции (i, j, k, l) в очереди l0. Для реальной
# I очереди это объём после уточнения Шага 7.2 (Шаг 8), для виртуальных очередей —
# нормированный объём Шага 6 (Шаги 7-8 к ним не применяются). Координата очереди,
# снятая индексом семейства, возвращается в матрицу осью Queue.
distributed_i_j_k_l_l0 = assign_matrix(replace_coord(estimated_i_j_k_l_last(1 from R), 1 from R, First), replace_coord(normalized_i_j_k_l(2 from R)(1), 2 from R, Second), replace_coord(normalized_i_j_k_l(3 from R)(1), 3 from R, Third), replace_coord(normalized_i_j_k_l(4 from R)(1), 4 from R, Fourth))
    where
        estimated_i_j_k_l_last(1 from R)(i, j, l, k) of number
        normalized_i_j_k_l(l0)(1)(i, j, l, k)        of number
        distributed_i_j_k_l_l0(i, j, l, k, l0)       of number
        estimated_i_j_k_l_last(1 from R) of matrix(Product, Refinery, Market_participant, Region)
        normalized_i_j_k_l(l0)(1)        of matrix(Product, Refinery, Market_participant, Region)
        distributed_i_j_k_l_l0           of matrix(Product, Refinery, Market_participant, Region, Queue)
            where
                n of index = 1 # Индекс матрицы нормирования (единственная итерация виртуальной очереди)
                Product, Refinery, Market_participant, Region, Queue from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди

# q-й Запрос: его запрашиваемый объём в разрезе нефтебазы и условия поставки, на
# которые он подан (ось Request снята выбором координаты).
requests_front(q) = filter_by_coordinate(requests_i_j_x_k_l_s_l0_q, q)
    where
        requests_i_j_x_k_l_s_l0_q(i, j, x, k, l, l0, s, q) of number # Запрашиваемый объем НП
        requests_front(q)(i, j, x, k, l, l0, s)            of number
        requests_i_j_x_k_l_s_l0_q of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_front(q)         of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms)
            where
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# Ключ сортировки q-го Запроса: запрашиваемый объём, умноженный на D + 1, минус номер
# Запроса. Ключи убывают по объёму, а при равных объёмах растут по номеру Запроса,
# поэтому порядок «по убыванию объёма, при равных объёмах — по хронологии» задан одним
# числом, и внутри коллекции все ключи различны (запрашиваемые объёмы — целые числа МТ,
# а разность номеров Запросов не достигает D + 1).
requests_key_q(q) = replace_coord(for_each_element(for_each_element(requests_front(q), "*", D + 1), "-", q), q, q from Request)
    where
        requests_front(q)(i, j, x, k, l, l0, s)    of number
        requests_key_q(q)(i, j, x, k, l, l0, s, q) of number # Ключ сортировки
        requests_front(q) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms)
        requests_key_q(q) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        "*" from operation
        "-" from operation
            where
                D of index = length(Request) # Количество Запросов
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# Ключи сортировки всех Запросов в одной матрице.
requests_key = assign_matrix(requests_key_q(1), ..., requests_key_q(D))
    where
        requests_key_q(q)(i, j, x, k, l, l0, s, q) of number
        requests_key(i, j, x, k, l, l0, s, q)      of number
        requests_key_q(q) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_key      of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
            where
                D of index = length(Request) # Количество Запросов
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# Ключ q-го Запроса в форме коллекции: у Запроса ровно одна нефтебаза и одно условие
# поставки, поэтому свёртка по этим осям возвращает сам ключ и делает его сравнимым
# со ключами всех Запросов коллекции.
requests_key_front(q) = sum_by_axes(filter_by_coordinate(requests_key, q), Terminal, Ship_terms)
    where
        requests_key(i, j, x, k, l, l0, s, q) of number
        requests_key_front(q)(i, j, l, k, l0) of number
        requests_key          of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_key_front(q) of matrix(Product, Refinery, Market_participant, Region, Queue)
            where
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# Запросы коллекции с БОЛЬШИМ ключом, чем у q-го Запроса, — то есть Запросы, которые
# перебираются раньше него.
requests_greater(q) = filter_by_pair(requests_key, ">", requests_key_front(q))
    where
        requests_key(i, j, x, k, l, l0, s, q)        of number
        requests_key_front(q)(i, j, l, k, l0)        of number
        requests_greater(q)(i, j, x, k, l, l0, s, q) of number
        requests_key          of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_key_front(q) of matrix(Product, Refinery, Market_participant, Region, Queue)
        requests_greater(q)   of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        ">" from condition
            where
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# Порядковый номер q-го Запроса в переборе своей коллекции: количество Запросов
# коллекции с большим ключом плюс единица. У самого крупного Запроса номер 1.
requests_rank_q(q) = replace_coord(for_each_element(sum_by_axes(count_coordinates_by_axis(requests_greater(q), Request), Terminal, Ship_terms), "+", 1), q, q from Request)
    where
        requests_greater(q)(i, j, x, k, l, l0, s, q) of number
        requests_rank_q(q)(i, j, l, k, l0, q)        of number # Порядковый номер Запроса
        requests_greater(q) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_rank_q(q)  of matrix(Product, Refinery, Market_participant, Region, Queue, Request)
        "+" from operation
            where
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# Порядковые номера всех Запросов в одной матрице.
requests_rank = assign_matrix(requests_rank_q(1), ..., requests_rank_q(D))
    where
        requests_rank_q(q)(i, j, l, k, l0, q) of number
        requests_rank(i, j, l, k, l0, q)      of number
        requests_rank_q(q) of matrix(Product, Refinery, Market_participant, Region, Queue, Request)
        requests_rank      of matrix(Product, Refinery, Market_participant, Region, Queue, Request)
            where
                D of index = length(Request) # Количество Запросов
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# Количество Запросов в коллекции: у Запроса ровно одна нефтебаза и одно условие
# поставки, поэтому достаточно посчитать координаты оси Request и свернуть эти две оси.
requests_count = sum_by_axes(count_coordinates_by_axis(requests_i_j_x_k_l_s_l0_q, Request), Terminal, Ship_terms)
    where
        requests_i_j_x_k_l_s_l0_q(i, j, x, k, l, l0, s, q) of number
        requests_count(i, j, l, k, l0)                     of number # Количество Запросов коллекции
        requests_i_j_x_k_l_s_l0_q of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_count            of matrix(Product, Refinery, Market_participant, Region, Queue)
            where
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# Самый мелкий Запрос каждой коллекции: его порядковый номер равен количеству Запросов
# коллекции. Перебор заканчивается на нём, поэтому именно он забирает остаток.
requests_rank_last = filter_by_pair(requests_rank, "=", requests_count)
    where
        requests_rank(i, j, l, k, l0, q)      of number
        requests_count(i, j, l, k, l0)        of number
        requests_rank_last(i, j, l, k, l0, q) of number
        requests_rank      of matrix(Product, Refinery, Market_participant, Region, Queue, Request)
        requests_count     of matrix(Product, Refinery, Market_participant, Region, Queue)
        requests_rank_last of matrix(Product, Refinery, Market_participant, Region, Queue, Request)
        "=" from condition
            where
                Product, Refinery, Market_participant, Region, Queue, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                q  for Z  from index # Индексы запросов

# Нераспределённый остаток коллекции перед первым (самым крупным) её Запросом — весь
# предоставленный коллекции объём.
requests_remainder(1) = distributed_i_j_k_l_l0
    where
        distributed_i_j_k_l_l0(i, j, l, k, l0) of number
        requests_remainder(1)(i, j, l, k, l0)  of number
        distributed_i_j_k_l_l0 of matrix(Product, Refinery, Market_participant, Region, Queue)
        requests_remainder(1)  of matrix(Product, Refinery, Market_participant, Region, Queue)
            where
                Product, Refinery, Market_participant, Region, Queue from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди

# m-й по порядку перебора Запрос каждой коллекции с его запрашиваемым объёмом.
requests_ranked_front(m) = filter_by_pair(requests_i_j_x_k_l_s_l0_q, contains, filter_by_value(requests_rank, "=", m))
    where
        requests_i_j_x_k_l_s_l0_q(i, j, x, k, l, l0, s, q) of number
        requests_rank(i, j, l, k, l0, q)                   of number
        requests_ranked_front(m)(i, j, x, k, l, l0, s, q)  of number
        requests_i_j_x_k_l_s_l0_q of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_rank             of matrix(Product, Refinery, Market_participant, Region, Queue, Request)
        requests_ranked_front(m)  of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        contains from condition
        "=" from condition
            where
                m of index = 1, ..., D # Порядковые номера перебора
                D of index = length(Request) # Количество Запросов
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# m-й Запрос, если он НЕ самый мелкий в своей коллекции: такой Запрос наливается только
# целиком.
requests_ranked_front_head(m) = filter_by_pair(requests_ranked_front(m), not_contains, requests_rank_last)
    where
        requests_ranked_front(m)(i, j, x, k, l, l0, s, q)      of number
        requests_rank_last(i, j, l, k, l0, q)                  of number
        requests_ranked_front_head(m)(i, j, x, k, l, l0, s, q) of number
        requests_ranked_front(m)      of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_rank_last            of matrix(Product, Refinery, Market_participant, Region, Queue, Request)
        requests_ranked_front_head(m) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        not_contains from condition
            where
                m of index = 1, ..., D # Порядковые номера перебора
                D of index = length(Request) # Количество Запросов
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# m-й Запрос, если он самый мелкий в своей коллекции: на нём перебор заканчивается.
requests_ranked_front_tail(m) = filter_by_pair(requests_ranked_front(m), contains, requests_rank_last)
    where
        requests_ranked_front(m)(i, j, x, k, l, l0, s, q)      of number
        requests_rank_last(i, j, l, k, l0, q)                  of number
        requests_ranked_front_tail(m)(i, j, x, k, l, l0, s, q) of number
        requests_ranked_front(m)      of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_rank_last            of matrix(Product, Refinery, Market_participant, Region, Queue, Request)
        requests_ranked_front_tail(m) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        contains from condition
            where
                m of index = 1, ..., D # Порядковые номера перебора
                D of index = length(Request) # Количество Запросов
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# Объём, выделенный m-му Запросу, если он не самый мелкий: Запрос наливается ЦЕЛИКОМ,
# когда помещается в остаток коллекции, иначе ячейка не проходит фильтр — такой Запрос
# отказан, а остаток сохраняется для следующих, более мелких Запросов коллекции.
requests_allocated_head(m) = filter_by_pair(requests_ranked_front_head(m), "<=", requests_remainder(m))
    where
        requests_ranked_front_head(m)(i, j, x, k, l, l0, s, q) of number
        requests_remainder(m)(i, j, l, k, l0)                  of number
        requests_allocated_head(m)(i, j, x, k, l, l0, s, q)    of number
        requests_ranked_front_head(m) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_remainder(m)         of matrix(Product, Refinery, Market_participant, Region, Queue)
        requests_allocated_head(m)    of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        "<=" from condition
            where
                m of index = 1, ..., D # Порядковые номера перебора
                D of index = length(Request) # Количество Запросов
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# Объём, выделенный m-му Запросу, если он самый мелкий в коллекции: он забирает остаток,
# то есть получает меньшее из запрашиваемого объёма и остатка. Коллекция с единственным
# Запросом целиком попадает в эту ветку.
requests_allocated_tail(m) = for_each_pair(requests_ranked_front_tail(m), min, requests_remainder(m))
    where
        requests_ranked_front_tail(m)(i, j, x, k, l, l0, s, q) of number
        requests_remainder(m)(i, j, l, k, l0)                  of number
        requests_allocated_tail(m)(i, j, x, k, l, l0, s, q)    of number
        requests_ranked_front_tail(m) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_remainder(m)         of matrix(Product, Refinery, Market_participant, Region, Queue)
        requests_allocated_tail(m)    of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        min from operation
            where
                m of index = 1, ..., D # Порядковые номера перебора
                D of index = length(Request) # Количество Запросов
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# Объём, выделенный m-му Запросу: ветки не пересекаются — Запрос либо самый мелкий в
# своей коллекции, либо нет.
requests_allocated(m) = assign_matrix(requests_allocated_head(m), requests_allocated_tail(m))
    where
        requests_allocated_head(m)(i, j, x, k, l, l0, s, q) of number
        requests_allocated_tail(m)(i, j, x, k, l, l0, s, q) of number
        requests_allocated(m)(i, j, x, k, l, l0, s, q)      of number
        requests_allocated_head(m) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_allocated_tail(m) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_allocated(m)      of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
            where
                m of index = 1, ..., D # Порядковые номера перебора
                D of index = length(Request) # Количество Запросов
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# Остаток коллекции перед следующим Запросом: текущий остаток минус налитый объём.
# Если m-й Запрос отказан, вычитается 0 и остаток не меняется.
requests_remainder(m + 1) = for_each_pair(requests_remainder(m), "-", sum_by_axes(requests_allocated(m), Terminal, Ship_terms, Request))
    where
        requests_remainder(m)(i, j, l, k, l0)          of number
        requests_allocated(m)(i, j, x, k, l, l0, s, q) of number
        requests_remainder(m + 1)(i, j, l, k, l0)      of number
        requests_remainder(m)     of matrix(Product, Refinery, Market_participant, Region, Queue)
        requests_allocated(m)     of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_remainder(m + 1) of matrix(Product, Refinery, Market_participant, Region, Queue)
        "-" from operation
            where
                m of index = 1, ..., D # Порядковые номера перебора
                D of index = length(Request) # Количество Запросов
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# Налитые объёмы всех Запросов: перебор коллекции идёт по одному Запросу за генерацию,
# поэтому ячейки разных генераций не пересекаются.
requests_i_j_x_k_l_s_l0_q_allocated = assign_matrix(requests_allocated(1), ..., requests_allocated(D))
    where
        requests_allocated(m)(i, j, x, k, l, l0, s, q)               of number
        requests_i_j_x_k_l_s_l0_q_allocated(i, j, x, k, l, l0, s, q) of number
        requests_allocated(m)               of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_i_j_x_k_l_s_l0_q_allocated of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
            where
                D of index = length(Request) # Количество Запросов
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# Итог Шага (N + 1): объём, предоставленный по каждому фактически поданному Запросу.
# Отказанный Запрос остаётся в матрице с нулём — обнуление исходной матрицы Запросов
# задаёт нули во всех ячейках, а налитые объёмы прибавляются к ним.
requests_i_j_x_k_l_s_l0_q_final = for_each_pair(for_each_element(requests_i_j_x_k_l_s_l0_q, "*", 0), "+", requests_i_j_x_k_l_s_l0_q_allocated)
    where
        requests_i_j_x_k_l_s_l0_q(i, j, x, k, l, l0, s, q)           of number
        requests_i_j_x_k_l_s_l0_q_allocated(i, j, x, k, l, l0, s, q) of number
        requests_i_j_x_k_l_s_l0_q_final(i, j, x, k, l, l0, s, q)     of number # Предоставленный объем НП
        requests_i_j_x_k_l_s_l0_q           of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_i_j_x_k_l_s_l0_q_allocated of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_i_j_x_k_l_s_l0_q_final     of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        "*" from operation
        "+" from operation
            where
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

## Трассировочная строка для запроса № Request(q):
# Шаг 1. Суммарный запрашиваемый объем НП $Product(i) на НПЗ
# $Refinery(j), МТ: $requests_i_j(i, j)
# Шаг 2. Доступный объем НП $Product(i) на НПЗ $Refinery(j), МТ:
# available_i_j_deficit(i, j). Установлен Период дефицита
# available_i_j_surplus(i, j). Установлен Период профицита
# Шаг 3.1. Средние объемы продаж НП $Product(i) в регионе
# $Region(k), МТ: moving_average(l, i, k)
# Шаг 3.2.1. Скорректированный на проливы объем НП $Product(i)
# на НПЗ $Refinery(j) в регион $Region(k), МТ: requests_i_j_k_l_deficit_single_corrected(i, k, l, j)
# Шаг 3.2.2. Скорректированный на проливы объем НП $Product(i)
# на НПЗ $Refinery(j) в регион $Region(k), МТ: requests_i_j_k_l_corrected(i, k, l, j)
# Шаг 4. Итоговый суммарный объем запросов НП $Product(i) на
# НПЗ $Refinery(j), МТ: requests_i_j_corrected(1 from R)(i, j)
# Шаг 5. Предварительный расчетный объем НП $Product(i) на НПЗ
# $Refinery(j) в регион $Region(k), МТ: estimated_i_j_k_l(1 from R)(1 from n)
# Шаг 6. Нормированный предоставляемый объем НП $Product(i) на
# НПЗ $Refinery(j) в регион  $Region(k), МТ: normalized_i_j_k_l(1 from R)(n)
# Шаг 7.1. Суммарный нормированный объем НП $Product(i) с НПЗ
# $Refinery(j), МТ: normalized_i_j(1 from R)(n)
# Шаг 7.1. Суммарный нормированный объем НП $Product(i) с НПЗ
# $Refinery(j) по запросам Субъекта рынка, МТ: normalized_i_j_l(1 from R)(n)
# Шаг 7.2. Доля Субъекта рынка, единиц: normalized_i_j_l_share(1 from R)(n)
# Шаг 7.2. Уточненный нормированный объем НП $Product(i) на НПЗ
# $Refinery(j) в регион $Region(k), МТ: estimated_i_j_k_l(1 from R)(n + 1)
# Шаг 8. Оставшийся после распределения Владельцам АЗС объем НП
# $Product(i) на НПЗ $Refinery(j), МТ: available_i_j_new(1 from R)
# Шаг 9а. Сформирован дополнительный Запрос объема, МТ: requests_i_j_k_l_virtual(2 from R)
# Шаг 4. Очередь II. Итоговый суммарный объем запросов НП $Product(i) на
# НПЗ $Refinery(j), МТ: requests_i_j_corrected(2 from R)(i, j)
# Шаг 5. Очередь II. Предварительный расчетный объем НП $Product(i) на НПЗ
# $Refinery(j) в регион $Region(k), МТ: estimated_i_j_k_l(2 from R)(1 from n)
# Шаг 6. Очередь II. Нормированный предоставляемый объем НП $Product(i) на
# НПЗ $Refinery(j) в регион  $Region(k), МТ: normalized_i_j_k_l(2 from R)(n)
# Шаг 10а. Суммарное распределение по очередям I, II, МТ: estimated_i_j_k_l_total(2 from R)(i, j, k, l)
# Шаг 11. Оставшийся после распределения Владельцам нефтебаз /
# резервуаров объем НП $Product(i) на НПЗ $Refinery(j), МТ: available_i_j_new(2 from R)
# Шаг N + 1. Предоставленный по Запросу объем НП $Product(i) на НПЗ
# $Refinery(j), МТ: requests_i_j_x_k_l_s_l0_q_final(i, j, x, k, l, l0, s, q)
