length, number                 from core
estimated_i_j_k_l              from ("step-7.2.lang")
normalized_i_j_x_k_l_s_l0_q    from ("step-6.lang")
axis, index, matrix            from ("matrix_types.lang")
assign_matrix                  from ("matrix_operation.lang")

### Дополнительный шаг алгоритма (Шаг N + 1)
# Сборка итога: объём по каждому фактически поданному Запросу уже посчитан по очередям —
# Шаг 5а разложил объём коллекции по её Запросам, Шаг 6 нормировал каждый Запрос по его
# условию поставки. Шаг (N + 1) только собирает эти матрицы всех очередей в одну.
# Номер Запроса уникален во всех очередях, поэтому матрицы очередей не пересекаются.

# Нормированные объёмы по Запросам I очереди — последняя итерация цикла Шагов 6-7.2,
# та же, что Шаг 8 берёт для коллекций. Последний член estimated_i_j_k_l — пустая
# матрица, которой Шаг 7.2 завершает цикл, поэтому last_n на единицу меньше его длины.
requests_i_j_x_k_l_s_l0_q_allocated(1 from R) = normalized_i_j_x_k_l_s_l0_q(1 from R)(last_n)
    where
        normalized_i_j_x_k_l_s_l0_q(1 from R)(last_n)(i, j, x, k, l, l0, s, q) of number
        requests_i_j_x_k_l_s_l0_q_allocated(1 from R)(i, j, x, k, l, l0, s, q) of number
        estimated_i_j_k_l(1 from R)                   of matrix(Product, Refinery, Region, Market_participant)
        normalized_i_j_x_k_l_s_l0_q(1 from R)(last_n) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_i_j_x_k_l_s_l0_q_allocated(1 from R) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
            where
                last_n of index = length(estimated_i_j_k_l(1 from R)) - 1 # Индекс последней итерации нормирования
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# Нормированные объёмы по Запросам II очереди и далее: цикла Шагов 6-7.2 у них нет,
# единственная итерация нормирования — первая.
requests_i_j_x_k_l_s_l0_q_allocated(l0) = normalized_i_j_x_k_l_s_l0_q(l0)(1)
    where
        l0 > 1 # Очереди II и далее; I очередь задана как (1 from R) выше
        normalized_i_j_x_k_l_s_l0_q(l0)(1)(i, j, x, k, l, l0, s, q)      of number
        requests_i_j_x_k_l_s_l0_q_allocated(l0)(i, j, x, k, l, l0, s, q) of number
        normalized_i_j_x_k_l_s_l0_q(l0)(1)      of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_i_j_x_k_l_s_l0_q_allocated(l0) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
            where
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

# Итог Шага (N + 1): объём, предоставленный по каждому фактически поданному Запросу.
# Запрос, которому не досталось объёма, уже стоит в матрице своей очереди с нулём (Шаги 5а и 6
# возвращают нулевые Запросы), поэтому отдельная нулевая база не нужна.
requests_i_j_x_k_l_s_l0_q_final = assign_matrix(requests_i_j_x_k_l_s_l0_q_allocated(1), ..., requests_i_j_x_k_l_s_l0_q_allocated(L))
    where
        requests_i_j_x_k_l_s_l0_q_allocated(l0)(i, j, x, k, l, l0, s, q) of number
        requests_i_j_x_k_l_s_l0_q_final(i, j, x, k, l, l0, s, q)         of number # Предоставленный объем НП
        requests_i_j_x_k_l_s_l0_q_allocated(l0) of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
        requests_i_j_x_k_l_s_l0_q_final         of matrix(Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request)
            where
                L of index = length(Queue) # Количество очередей
                Product, Refinery, Terminal, Region, Market_participant, Queue, Ship_terms, Request from axis # Оси
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                x  for X  from index # Индексы нефтебаз
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                l0 for R  from index # Индексы очереди
                s  for C  from index # Индексы условий поставки
                q  for Z  from index # Индексы запросов

## Трассировочная строка для запроса № Request(q):
# Шаг 1. Суммарный запрашиваемый объем НП $Product(i) на НПЗ
# $Refinery(j), МТ: $requests_i_j(i, j)
# Шаг 2. Доступный объем НП $Product(i) на НПЗ $Refinery(j), МТ:
# available_i_j_deficit(i, j). Установлен Период дефицита
# available_i_j_surplus(i, j). Установлен Период профицита
# Шаг 3.1. Средние объемы продаж НП $Product(i) в регионе
# $Region(k), МТ: moving_average(l, i, k)
# Шаг 3.2.1. Скорректированный на проливы объем НП $Product(i)
# на НПЗ $Refinery(j) в регион $Region(k), МТ: requests_i_j_k_l_deficit_single_corrected(i, k, l, j)
# Шаг 3.2.2. Скорректированный на проливы объем НП $Product(i)
# на НПЗ $Refinery(j) в регион $Region(k), МТ: requests_i_j_k_l_corrected(i, k, l, j)
# Шаг 4. Итоговый суммарный объем запросов НП $Product(i) на
# НПЗ $Refinery(j), МТ: requests_i_j_corrected(1 from R)(i, j)
# Шаг 5. Предварительный расчетный объем НП $Product(i) на НПЗ
# $Refinery(j) в регион $Region(k), МТ: estimated_i_j_k_l(1 from R)(1 from n)
# Шаг 6. Нормированный предоставляемый объем НП $Product(i) на
# НПЗ $Refinery(j) в регион  $Region(k), МТ: normalized_i_j_k_l(1 from R)(n)
# Шаг 7.1. Суммарный нормированный объем НП $Product(i) с НПЗ
# $Refinery(j), МТ: normalized_i_j(1 from R)(n)
# Шаг 7.1. Суммарный нормированный объем НП $Product(i) с НПЗ
# $Refinery(j) по запросам Субъекта рынка, МТ: normalized_i_j_l(1 from R)(n)
# Шаг 7.2. Доля Субъекта рынка, единиц: normalized_i_j_l_share(1 from R)(n)
# Шаг 7.2. Уточненный нормированный объем НП $Product(i) на НПЗ
# $Refinery(j) в регион $Region(k), МТ: estimated_i_j_k_l(1 from R)(n + 1)
# Шаг 8. Оставшийся после распределения Владельцам АЗС объем НП
# $Product(i) на НПЗ $Refinery(j), МТ: available_i_j_new(1 from R)
# Шаг 9. Доступный объем НП $Product(i) на НПЗ $Refinery(j) для II очереди,
# МТ: available_i_j(2 from R)
# Шаг 4. Очередь II. Итоговый суммарный объем запросов НП $Product(i) на
# НПЗ $Refinery(j), МТ: requests_i_j_corrected(2 from R)(i, j)
# Шаг 5. Очередь II. Предварительный расчетный объем НП $Product(i) на НПЗ
# $Refinery(j) в регион $Region(k), МТ: estimated_i_j_k_l(2 from R)(1 from n)
# Шаг 6. Очередь II. Нормированный предоставляемый объем НП $Product(i) на
# НПЗ $Refinery(j) в регион  $Region(k), МТ: normalized_i_j_k_l(2 from R)(n)
# Шаг 10а. Суммарное распределение по очередям I, II, МТ: estimated_i_j_k_l_total(2 from R)(i, j, k, l)
# Шаг 11. Оставшийся после распределения Владельцам нефтебаз /
# резервуаров объем НП $Product(i) на НПЗ $Refinery(j), МТ: available_i_j_new(2 from R)
# Шаг 12. Доступный объем НП $Product(i) на НПЗ $Refinery(j) для III очереди,
# МТ: available_i_j(3 from R)
# Шаг 4. Очередь III. Итоговый суммарный объем запросов НП $Product(i) на
# НПЗ $Refinery(j), МТ: requests_i_j_corrected(3 from R)(i, j)
# Шаг 5. Очередь III. Предварительный расчетный объем НП $Product(i) на НПЗ
# $Refinery(j) в регион $Region(k), МТ: estimated_i_j_k_l(3 from R)(1 from n)
# Шаг 6. Очередь III. Нормированный предоставляемый объем НП $Product(i) на
# НПЗ $Refinery(j) в регион  $Region(k), МТ: normalized_i_j_k_l(3 from R)(n)
# Шаг 13а. Суммарное распределение по очередям I, II, III, МТ: estimated_i_j_k_l_total(3 from R)(i, j, k, l)
# Шаг 14. Оставшийся после распределения Субъектам рынка из состава
# ГМК объем НП $Product(i) на НПЗ $Refinery(j), МТ: available_i_j_new(3 from R)
# Шаг 15. Доступный объем НП $Product(i) на НПЗ $Refinery(j) для IV очереди,
# МТ: available_i_j(4 from R)
# Шаг 4. Очередь IV. Итоговый суммарный объем запросов НП $Product(i) на
# НПЗ $Refinery(j), МТ: requests_i_j_corrected(4 from R)(i, j)
# Шаг 5. Очередь IV. Предварительный расчетный объем НП $Product(i) на НПЗ
# $Refinery(j) в регион $Region(k), МТ: estimated_i_j_k_l(4 from R)(1 from n)
# Шаг 6. Очередь IV. Нормированный предоставляемый объем НП $Product(i) на
# НПЗ $Refinery(j) в регион  $Region(k), МТ: normalized_i_j_k_l(4 from R)(n)
# Шаг 16а. Суммарное распределение по очередям I, II, III, IV, МТ: estimated_i_j_k_l_total(4 from R)(i, j, k, l)
# Шаг N + 1. Предоставленный по Запросу объем НП $Product(i) на НПЗ
# $Refinery(j), МТ: requests_i_j_x_k_l_s_l0_q_final(i, j, x, k, l, l0, s, q)
