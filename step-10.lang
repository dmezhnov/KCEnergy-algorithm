number                                from core
requests_i_j_k_l_s_virtual            from ("step-9.lang")
estimated_i_j_k_l_s_last              from ("step-8.lang")
normalized_i_j_k_l_s                  from ("step-6.lang")
for_each_pair, for_each_element       from ("matrix_operation.lang")
axis, index, matrix, operation        from ("matrix_types.lang")

### Шаг 10. Распределение НП по Запросам Владельцев нефтебаз/резервуаров (II очередь)
# Система выполняет шаги, аналогичные Шагам 4-6. Отдельная реализация не нужна:
# обобщённые формы (l0) в Шагах 4-6 уже описывают вторую очередь. Достаточно подать
# на их вход не исходные Запросы, а «виртуальные» Запросы r̃ из Шага 9a.

### Обвязка входа II очереди (аналог входа Шага 4)
# Скорректированный объём II очереди = виртуальный Запрос r̃ (Шаг 9a). Коррекции на проливы
# во II очереди нет, ось нефтебаз (Terminal) уже свёрнута. Это .Second-определение заменяет
# обобщённый вход Шага 4: его guard сужен до l0 > 2, поэтому коллизии для l0 = 2 нет.
# Дальше generic-формы Шагов 5-6 сами строят estimated/normalized для II очереди.
requests_i_j_k_l_s_corrected.Second = requests_i_j_k_l_s_virtual.Second
    where
        requests_i_j_k_l_s_corrected.Second(i, j, s, l, k) of number
        requests_i_j_k_l_s_virtual.Second(i, j, s, l, k)   of number
        requests_i_j_k_l_s_corrected.Second of matrix(Product, Refinery, Ship_terms, Market_participant, Region)
        requests_i_j_k_l_s_virtual.Second   of matrix(Product, Refinery, Ship_terms, Market_participant, Region)
            where
                Product, Refinery, Ship_terms, Market_participant, Region from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                s  for C  from index # Индексы условия поставки
                l  for P  from index # Индексы субъекта рынка
                k  for K  from index # Индексы региона

### Шаг 10a. Суммарное распределение по очередям I, II (s⃛ = s̈ + ẗ)
# Итоговый предоставленный объём = объём I очереди (s̈ = estimated_i_j_k_l_s_last.First, Шаги 3-7)
# плюс объём II очереди по виртуальному Запросу (ẗ = normalized_i_j_k_l_s.Second(1), Шаги 4-6).
# Используется явное сложение "+", т.к. одни и те же (i, j, k, l, s) получают объём в обеих
# очередях; assign_matrix объединяет ячейки присваиванием и для суммы не подходит.
estimated_i_j_k_l_s_total = for_each_pair(estimated_i_j_k_l_s_last.First, "+", normalized_i_j_k_l_s.Second(1))
    where
        estimated_i_j_k_l_s_last.First(i, j, k, l, s)  of number
        normalized_i_j_k_l_s.Second(1)(i, j, k, l, s)  of number
        estimated_i_j_k_l_s_total(i, j, k, l, s)       of number
        estimated_i_j_k_l_s_last.First of matrix(Product, Refinery, Region, Market_participant, Ship_terms)
        normalized_i_j_k_l_s.Second(1) of matrix(Product, Refinery, Region, Market_participant, Ship_terms)
        estimated_i_j_k_l_s_total      of matrix(Product, Refinery, Region, Market_participant, Ship_terms)
        "+" from operation
            where
                n  of          index = 1 # Индекс матрицы нормирования (единственная итерация)
                Product, Refinery, Region, Market_participant, Ship_terms from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                s  for C  from index # Индексы условия поставки

# Виртуальные Запросы после II очереди элиминируются (ẗ_request <- 0) и далее не используются.
requests_i_j_k_l_s_virtual_final.Second = for_each_element(requests_i_j_k_l_s_corrected.Second, "*", 0)
    where
        requests_i_j_k_l_s_corrected.Second(i, j, s, l, k)     of number
        requests_i_j_k_l_s_virtual_final.Second(i, j, s, l, k) of number
        requests_i_j_k_l_s_corrected.Second     of matrix(Product, Refinery, Ship_terms, Market_participant, Region)
        requests_i_j_k_l_s_virtual_final.Second of matrix(Product, Refinery, Ship_terms, Market_participant, Region)
        "*" from operation
            where
                Product, Refinery, Ship_terms, Market_participant, Region from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                s  for C  from index # Индексы условия поставки
                l  for P  from index # Индексы субъекта рынка
                k  for K  from index # Индексы региона
