number                 from core
requests_i_j_k_l_queue from ("step-1.lang")
axis, index, matrix    from ("matrix_types.lang")

### Шаг 10. Распределение НП по Запросам Владельцев нефтебаз/резервуаров (II очередь)
# Система выполняет шаги, аналогичные Шагам 4-6. Отдельная реализация не нужна:
# обобщённые формы (l0) в Шагах 4-6 уже описывают вторую очередь. На их вход подаются
# исходные Запросы 2-й очереди (R=2).

### Обвязка входа II очереди (аналог входа Шага 4)
# Вход II очереди = исходные Запросы 2-й очереди (R=2).
# Коррекции на проливы во II очереди нет. Это (2 from R)-определение заменяет
# обобщённый вход Шага 4 (его guard сужен до l0 > 2, поэтому коллизии для l0 = 2 нет); дальше
# generic-формы Шагов 5-6 сами строят estimated/normalized для II очереди.

# Исходные Запросы 2-й очереди берутся прямо из Шага 1: свёртка по нефтебазам и условиям
# поставки сделана в Шаге -1.
requests_i_j_k_l_corrected_queue(2 from R) = requests_i_j_k_l_queue(2 from R)
    where
        requests_i_j_k_l_queue(2 from R)(i, j, l, k)           of number
        requests_i_j_k_l_corrected_queue(2 from R)(i, j, l, k) of number
        requests_i_j_k_l_queue(2 from R)           of matrix(Product, Refinery, Market_participant, Region)
        requests_i_j_k_l_corrected_queue(2 from R) of matrix(Product, Refinery, Market_participant, Region)
            where
                Product, Refinery, Market_participant, Region from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                l  for P  from index # Индексы субъекта рынка
                k  for K  from index # Индексы региона
