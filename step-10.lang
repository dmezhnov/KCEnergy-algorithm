number                                         from core
requests_i_j_k_l_virtual                       from ("step-9.lang")
requests_i_j_k_l_queue                         from ("step-1.lang")
estimated_i_j_k_l_last                         from ("step-8.lang")
normalized_i_j_k_l                             from ("step-6.lang")
for_each_pair, for_each_element, assign_matrix from ("matrix_operation.lang")
axis, index, matrix, operation                 from ("matrix_types.lang")

### Шаг 10. Распределение НП по Запросам Владельцев нефтебаз/резервуаров (II очередь)
# Система выполняет шаги, аналогичные Шагам 4-6. Отдельная реализация не нужна:
# обобщённые формы (l0) в Шагах 4-6 уже описывают вторую очередь. На их вход подаются
# исходные Запросы 2-й очереди (R=2).

### Обвязка входа II очереди (аналог входа Шага 4)
# Вход II очереди = исходные Запросы 2-й очереди (R=2); виртуальные Запросы r̃ Шага 9a в него
# не входят. Коррекции на проливы во II очереди нет. Это (2 from R)-определение заменяет
# обобщённый вход Шага 4 (его guard сужен до l0 > 2, поэтому коллизии для l0 = 2 нет); дальше
# generic-формы Шагов 5-6 сами строят estimated/normalized для II очереди.

# Исходные Запросы 2-й очереди берутся прямо из Шага 1: свёртка по нефтебазам и условиям
# поставки сделана в Шаге -1.
requests_i_j_k_l_corrected_queue(2 from R) = requests_i_j_k_l_queue(2 from R)
    where
        requests_i_j_k_l_queue(2 from R)(i, j, l, k)           of number
        requests_i_j_k_l_corrected_queue(2 from R)(i, j, l, k) of number
        requests_i_j_k_l_queue(2 from R)           of matrix(Product, Refinery, Market_participant, Region)
        requests_i_j_k_l_corrected_queue(2 from R) of matrix(Product, Refinery, Market_participant, Region)
            where
                Product, Refinery, Market_participant, Region from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                l  for P  from index # Индексы субъекта рынка
                k  for K  from index # Индексы региона

### Шаг 10a. Суммарное распределение по очередям I, II (s⃛ = s̈ + ẗ)
# Итоговый предоставленный объём = объём I очереди (s̈ = estimated_i_j_k_l_last(1 from R), Шаги 3-7)
# плюс объём II очереди (ẗ = normalized_i_j_k_l(2 from R)(1), Шаги 4-6).
# Это объединение-со-сложением по ОБЪЕДИНЕНИЮ координат:
#   - ячейки только I очереди (s̈, без II)          -> s̈;
#   - ячейки только II очереди (Запросы R=2, без I) -> ẗ;
#   - общие ячейки (один Субъект в обеих очередях)  -> s̈ + ẗ.
# for_each_pair(s̈, "+", ẗ) ведётся по координатам ЛЕВОГО операнда (s̈): покрывает «только I» и
# «общие», но теряет «только II». Чтобы вернуть «только II», накрываем сумму на ẗ через
# assign_matrix — суммы перекрывают исходные ẗ, а уникальные для II очереди ячейки ẗ остаются.
# Это база семейства estimated_i_j_k_l_total: следующие очереди (l0 > 2) накапливают итог
# на ней (ниже).
estimated_i_j_k_l_total(2 from R) = assign_matrix(normalized_i_j_k_l(2 from R)(1), for_each_pair(estimated_i_j_k_l_last(1 from R), "+", normalized_i_j_k_l(2 from R)(1)))
    where
        estimated_i_j_k_l_last(1 from R)(i, j, k, l)  of number
        normalized_i_j_k_l(2 from R)(1)(i, j, k, l)   of number
        estimated_i_j_k_l_total(2 from R)(i, j, k, l) of number
        estimated_i_j_k_l_last(1 from R)  of matrix(Product, Refinery, Region, Market_participant)
        normalized_i_j_k_l(2 from R)(1)   of matrix(Product, Refinery, Region, Market_participant)
        estimated_i_j_k_l_total(2 from R) of matrix(Product, Refinery, Region, Market_participant)
        "+" from operation
            where
                n  of          index = 1 # Индекс матрицы нормирования (единственная итерация)
                Product, Refinery, Region, Market_participant from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка

# Виртуальные Запросы после II очереди элиминируются (ẗ_request <- 0) и далее не используются.
# Зануляются ИМЕННО виртуальные Запросы Шага 9a, а не Запросы R=2: исходные Запросы R=2
# реальны, их остаток обрабатывается штатным механизмом следующих очередей.
requests_i_j_k_l_virtual_final(2 from R) = for_each_element(requests_i_j_k_l_virtual(2 from R), "*", 0)
    where
        requests_i_j_k_l_virtual(2 from R)(i, j, l, k)       of number
        requests_i_j_k_l_virtual_final(2 from R)(i, j, l, k) of number
        requests_i_j_k_l_virtual(2 from R)       of matrix(Product, Refinery, Market_participant, Region)
        requests_i_j_k_l_virtual_final(2 from R) of matrix(Product, Refinery, Market_participant, Region)
        "*" from operation
            where
                Product, Refinery, Market_participant, Region from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                l  for P  from index # Индексы субъекта рынка
                k  for K  from index # Индексы региона

### Шаг 13a (III очередь) и Шаг 16a (IV очередь). Суммарное распределение по очередям I … l0
# То же объединение-со-сложением, но накопительное: к итогу предыдущих очередей
# (estimated_i_j_k_l_total(l0 - 1)) прибавляется нормированный объём очереди l0
# (ü = normalized_i_j_k_l(l0)(1), Шаги 4-6 в обобщённой форме). Роль s̈ из Шага 10a здесь играет
# накопленный итог, поэтому отдельной формулы на каждую очередь не нужно:
#   - ячейки только прошлых очередей          -> итог как был;
#   - ячейки только очереди l0                -> ü;
#   - общие ячейки (Субъект получал и раньше) -> итог + ü.
# Семейство estimated_i_j_k_l_total делится на непересекающиеся части: l0 = 2 (выше, база на
# итоге I очереди) и l0 > 2 (здесь). Конкретные экземпляры приведены в step-10.example_N.lang:
# l0 = 3 — Шаг 13a; l0 = 4 — Шаг 16a.
estimated_i_j_k_l_total(l0) = assign_matrix(normalized_i_j_k_l(l0)(1), for_each_pair(estimated_i_j_k_l_total(l0 - 1), "+", normalized_i_j_k_l(l0)(1)))
    where
        l0 > 2 # Очереди III и далее; II очередь задана как (2 from R) выше
        estimated_i_j_k_l_total(l0 - 1)(i, j, k, l) of number
        normalized_i_j_k_l(l0)(1)(i, j, k, l)       of number
        estimated_i_j_k_l_total(l0)(i, j, k, l)     of number
        estimated_i_j_k_l_total(l0 - 1) of matrix(Product, Refinery, Region, Market_participant)
        normalized_i_j_k_l(l0)(1)       of matrix(Product, Refinery, Region, Market_participant)
        estimated_i_j_k_l_total(l0)     of matrix(Product, Refinery, Region, Market_participant)
        "+" from operation
            where
                l0 for R  from index # Индексы очереди
                n  of          index = 1 # Индекс матрицы нормирования (единственная итерация)
                Product, Refinery, Region, Market_participant from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка

## Трассировочная строка для запроса № Request(q):
# Шаг 1. Суммарный запрашиваемый объем НП $Product(i) на НПЗ
# $Refinery(j), МТ: $requests_i_j(i, j)
# Шаг 2. Доступный объем НП $Product(i) на НПЗ $Refinery(j), МТ:
# available_i_j_deficit(i, j). Установлен Период дефицита
# available_i_j_surplus(i, j). Установлен Период профицита
# Шаг 3.1. Средние объемы продаж НП $Product(i) в регионе
# $Region(k), МТ: moving_average(l, i, k)
# Шаг 3.2.1. Скорректированный на проливы объем НП $Product(i)
# на НПЗ $Refinery(j) в регион $Region(k), МТ: requests_i_j_k_l_deficit_single_corrected(i, k, l, j)
# Шаг 3.2.2. Скорректированный на проливы объем НП $Product(i)
# на НПЗ $Refinery(j) в регион $Region(k), МТ: requests_i_j_k_l_corrected(i, k, l, j)
# Шаг 4. Итоговый суммарный объем запросов НП $Product(i) на
# НПЗ $Refinery(j), МТ: requests_i_j_corrected(1 from R)(i, j)
# Шаг 5. Предварительный расчетный объем НП $Product(i) на НПЗ
# $Refinery(j) в регион $Region(k), МТ: estimated_i_j_k_l(1 from R)(1 from n)
# Шаг 6. Нормированный предоставляемый объем НП $Product(i) на
# НПЗ $Refinery(j) в регион  $Region(k), МТ: normalized_i_j_k_l(1 from R)(n)
# Шаг 7.1. Суммарный нормированный объем НП $Product(i) с НПЗ
# $Refinery(j), МТ: normalized_i_j(1 from R)(n)
# Шаг 7.1. Суммарный нормированный объем НП $Product(i) с НПЗ
# $Refinery(j) по запросам Субъекта рынка, МТ: normalized_i_j_l(1 from R)(n)
# Шаг 7.2. Доля Субъекта рынка, единиц: normalized_i_j_l_share(1 from R)(n)
# Шаг 7.2. Уточненный нормированный объем НП $Product(i) на НПЗ
# $Refinery(j) в регион $Region(k), МТ: estimated_i_j_k_l(1 from R)(n + 1)
# Шаг 8. Оставшийся после распределения Владельцам АЗС объем НП
# $Product(i) на НПЗ $Refinery(j), МТ: available_i_j_new(1 from R)
# Шаг 4. Очередь II. Итоговый суммарный объем запросов НП $Product(i) на
# НПЗ $Refinery(j), МТ: requests_i_j_corrected(2 from R)(i, j)
# Шаг 5. Очередь II. Предварительный расчетный объем НП $Product(i) на НПЗ
# $Refinery(j) в регион $Region(k), МТ: estimated_i_j_k_l(2 from R)(1 from n)
# Шаг 6. Очередь II. Нормированный предоставляемый объем НП $Product(i) на
# НПЗ $Refinery(j) в регион  $Region(k), МТ: normalized_i_j_k_l(2 from R)(n)
# Шаг 10а. Суммарное распределение по очередям I, II, МТ: estimated_i_j_k_l_total(2 from R)(i, j, k, l)
