number                                    from core
operation                                 from ("matrix_types.lang")
sum_by_axes, for_each_pair, assign_matrix from ("matrix_operation.lang")
requests_i_j_k_l_deficit_multiple         from ("step-3.2.0.lang")
requests_i_j_k_l_all_multiple             from ("step-3.2.0.lang")
requests_i_j_k_l_surplus                  from ("step-3.2.0.lang")
requests_i_j_k_l_deficit_single_corrected from ("step-3.2.1.lang")
requests_i_j_k_l_queue                    from ("step-1.lang")
moving_average                            from ("step-3.1.0.lang")

# Матрица суммарных запросов по ВСЕМ НПЗ (включая профицитные) для субъектов рынка с множественными дефицитными НПЗ
# Знаменатель для расчёта долей: r_ikl = Σ_j r_ijkl — запросы субъекта рынка по всем его НПЗ.
# В отличие от Шага 3.2.1 доля здесь не вырождается в единицу: у такого субъекта рынка
# несколько НПЗ, поэтому знаменатель строго больше каждого отдельного слагаемого.
# Суммировать по условиям поставки и нефтебазам не требуется — эти оси объединены на Шаге -1.
requests_i_k_l_all_multiple = sum_by_axes(requests_i_j_k_l_all_multiple, Refinery)
    where
        requests_i_j_k_l_all_multiple(i, k, l, j) of number
        requests_i_k_l_all_multiple(i, k, l)      of number
        requests_i_j_k_l_all_multiple of matrix(Product, Region, Market_participant, Refinery)
        requests_i_k_l_all_multiple   of matrix(Product, Region, Market_participant)
            where
                Product, Region, Market_participant, Refinery from axis
                i  for I  from index # Индексы нефпродукта
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                j  for J  from index # Индексы НПЗ

# Матрица долей множественных (запросы на несколько НПЗ) дефицитных запросов (запросы на дефицитный НПЗ) первой очереди
requests_i_j_k_l_deficit_multiple_share = for_each_pair(requests_i_j_k_l_deficit_multiple, "/", requests_i_k_l_all_multiple)
    where
        requests_i_j_k_l_deficit_multiple_share(i, k, l, j) of number
        requests_i_j_k_l_deficit_multiple(i, k, l, j)       of number
        requests_i_k_l_all_multiple(i, k, l)                of number
        requests_i_j_k_l_deficit_multiple_share of matrix(Product, Region, Market_participant, Refinery)
        requests_i_j_k_l_deficit_multiple       of matrix(Product, Region, Market_participant, Refinery)
        requests_i_k_l_all_multiple             of matrix(Product, Region, Market_participant)
            where
                "/" from operation
                Product, Region, Market_participant, Refinery from axis
                i  for I  from index # Индексы нефпродукта
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                j  for J  from index # Индексы НПЗ

# Матрица для вычисления выпадающих при корректировке на проливы объемов множественных (запросы на несколько НПЗ) дефицитных запросов (запросы на дефицитный НПЗ) первой очереди
requests_i_j_k_l_deficit_multiple_pend_aux = for_each_pair(requests_i_j_k_l_deficit_multiple_share, "*", moving_average)
    where
        requests_i_j_k_l_deficit_multiple_pend_aux(i, k, l, j) of number
        requests_i_j_k_l_deficit_multiple_share(i, k, l, j)    of number
        moving_average(i, k, l)                                of number # Скользящее среднее
        requests_i_j_k_l_deficit_multiple_pend_aux of matrix(Product, Region, Market_participant, Refinery)
        requests_i_j_k_l_deficit_multiple_share    of matrix(Product, Region, Market_participant, Refinery)
        moving_average                             of matrix(Product, Region, Market_participant) # Скользящее среднее
            where
                "*" from operation
                Product, Region, Market_participant, Refinery from axis
                i  for I  from index # Индексы нефпродукта
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                j  for J  from index # Индексы НПЗ

# Объединённая матрица скорректированных на проливы объёмов по всем запросам первой очереди (вспомогательная, до ограничения объёмом запроса):
# единичные дефицитные (Шаг 3.2.1, _corrected) + множественные дефицитные (Шаг 3.2.2, _pend_aux) + профицитные (полный запрашиваемый объём).
# Координаты трёх матриц не пересекаются, поэтому это объединение без конфликтов.
requests_i_j_k_l_corrected_aux = assign_matrix(requests_i_j_k_l_deficit_single_corrected, requests_i_j_k_l_deficit_multiple_pend_aux, requests_i_j_k_l_surplus)
    where
        requests_i_j_k_l_corrected_aux(i, k, l, j)             of number
        requests_i_j_k_l_deficit_single_corrected(i, k, l, j)  of number
        requests_i_j_k_l_deficit_multiple_pend_aux(i, k, l, j) of number
        requests_i_j_k_l_surplus(i, j, k, l)                   of number
        requests_i_j_k_l_corrected_aux             of matrix(Product, Region, Market_participant, Refinery)
        requests_i_j_k_l_deficit_single_corrected  of matrix(Product, Region, Market_participant, Refinery)
        requests_i_j_k_l_deficit_multiple_pend_aux of matrix(Product, Region, Market_participant, Refinery)
        requests_i_j_k_l_surplus                   of matrix(Product, Refinery, Region, Market_participant)
            where
                Product, Region, Market_participant, Refinery from axis
                i  for I  from index # Индексы нефпродукта
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                j  for J  from index # Индексы НПЗ

# Итоговый скорректированный на проливы объём по всем запросам первой очереди (Таблица 68):
# объём не может превышать запрошенный, поэтому берём поэлементный минимум исходного запроса
# и вспомогательного скорректированного объёма. Для профицитных запросов min = полный запрос,
# для множественных дефицитных min = доля * проливы (всегда меньше запроса).
requests_i_j_k_l_corrected = for_each_pair(requests_i_j_k_l_queue(1 from R), min, requests_i_j_k_l_corrected_aux)
    where
        requests_i_j_k_l_corrected(i, k, l, j)       of number
        requests_i_j_k_l_queue(1 from R)(i, k, l, j) of number # Запрашиваемый объём НП
        requests_i_j_k_l_corrected_aux(i, k, l, j)   of number
        requests_i_j_k_l_corrected       of matrix(Product, Region, Market_participant, Refinery)
        requests_i_j_k_l_queue(1 from R) of matrix(Product, Region, Market_participant, Refinery)
        requests_i_j_k_l_corrected_aux   of matrix(Product, Region, Market_participant, Refinery)
            where
                min from operation
                Product, Region, Market_participant, Refinery from axis
                i  for I  from index # Индексы нефпродукта
                k  for K  from index # Индексы региона
                l  for P  from index # Индексы субъекта рынка
                j  for J  from index # Индексы НПЗ
                R         from index # Индексы очереди

## Трассировочная строка для запроса № Request(q):
# Шаг 1. Суммарный запрашиваемый объем НП $Product(i) на НПЗ
# $Refinery(j), МТ: $requests_i_j(i, j)
# Шаг 2. Доступный объем НП $Product(i) на НПЗ $Refinery(j), МТ:
# available_i_j_deficit(i, j). Установлен Период дефицита
# available_i_j_surplus(i, j). Установлен Период профицита
# Шаг 3.1. Средние объемы продаж НП $Product(i) в регионе
# $Region(k), МТ: moving_average(l, i, k)
# Шаг 3.2.1. Скорректированный на проливы объем НП $Product(i)
# на НПЗ $Refinery(j) в регион $Region(k), МТ: requests_i_j_k_l_deficit_single_corrected(i, k, l, j)
# Шаг 3.2.2. Скорректированный на проливы объем НП $Product(i)
# на НПЗ $Refinery(j) в регион $Region(k), МТ: requests_i_j_k_l_corrected(i, k, l, j)
