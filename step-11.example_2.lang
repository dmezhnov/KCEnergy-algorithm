### Шаг 11. Оставшийся после распределения Владельцам нефтебаз/резервуаров объём НП (пример 2)
# v3_ij = v2_ij − Σ_k Σ_l' ẗ_ijkl', где v2 = available_i_j_new(1 from R) = { 10, 390, 1900 }
# (остаток I очереди, Шаг 8), а ẗ = normalized_i_j_k_l(2 from R)(1) — нормированные объёмы,
# предоставленные Владельцам нефтебаз/резервуаров во II очереди (Шаг 6).
# ПКОП (J=1) прошёл гейт Шага 9 с остатком 10 и обслужил #203 (65) и #204 (4): нормирование
# подняло оба объёма до минимальных норм (вагонная 65 МТ и шаг вывоза 4 МТ), поэтому роздано
# 69 МТ при остатке 10 — остаток уходит в минус (-59). Так же ведёт себя IV очередь примера 1:
# округление коэффициента нормирования может дать объём больше доступного.
# АНПЗ (J=2) обслужил #205, #206, #207, #208, #209: 380 из 390, остаток 10.
# ПНХЗ (J=3) обслужил #201, #202 (195 из 1900), остаток 1705.

# Суммарно предоставленный во II очереди объём по НПЗ (свёртка ẗ по региону и субъекту).
estimated_i_j(2 from R) = sum_by_axes(normalized_i_j_k_l(2 from R)(1), Region, Market_participant) = {
    (1 from I) = {
        (1 from I, 1 from J) =                    65 +   4 =  69,  # 203 + 204
        (1 from I, 2 from J) = 130 +  70 + 130 +  15 +  35 = 380,  # 205 + 206 + 207 + 208 + 209
        (1 from I, 3 from J) =                    65 + 130 = 195   # 201 + 202
    }
}
    where
        normalized_i_j_k_l(2 from R)(1)(i, j, l, k) of number
        estimated_i_j(2 from R)(i, j)               of number
        normalized_i_j_k_l(2 from R)(1) of matrix(Product, Refinery, Market_participant, Region)
        estimated_i_j(2 from R)         of matrix(Product, Refinery)
            where
                n  of   index = 1 # Индекс матрицы нормирования (единственная итерация)
                Product, Market_participant, Refinery, Region from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                l  for P  from index # Индексы субъекта рынка
                k  for K  from index # Индексы региона

# Матрица оставшихся после распределения Владельцам нефтебаз/резервуаров объёмов НП (v3 = v2 - ẗ).
# По ПКОП (J=1) вычитаются розданные 69 МТ при остатке 10, поэтому v3 уходит в минус.
available_i_j_new(2 from R) = for_each_pair(available_i_j_new(1 from R), "-", estimated_i_j(2 from R)) = {
    (1 from I) = {
        (1 from I, 1 from J) =   10 -  69 =  -59,
        (1 from I, 2 from J) =  390 - 380 =   10,
        (1 from I, 3 from J) = 1900 - 195 = 1705
    }
}
    where
        available_i_j_new(2 from R)(i, j) of number
        available_i_j_new(1 from R)(i, j) of number
        estimated_i_j(2 from R)(i, j)     of number
        available_i_j_new(2 from R) of matrix(Product, Refinery)
        available_i_j_new(1 from R) of matrix(Product, Refinery)
        estimated_i_j(2 from R)     of matrix(Product, Refinery)
        "-" from operation
            where
                Product, Refinery from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ

### Шаг 14. Оставшийся после распределения Субъектам рынка из состава ГМК объём НП (III очередь, пример 2)
# v4_ij = v3_ij − Σ_k Σ_l'' ü_ijkl'', где v3 = available_i_j_new(2 from R) = { -59, 10, 1705 } (выше),
# а ü = normalized_i_j_k_l(3 from R)(1) — нормированные объёмы Субъектов ГМК (Шаг 13, step-6.example_2).
# Распределение III очереди шло только с ПНХЗ (J=3): #301 (195) и #302 (250), итого 445.
# Профицит (445 < 1705), оба запроса удовлетворены полностью; остаток ПНХЗ 1705 - 445 = 1260.
# ПКОП (J=1) выбыл на гейте Шага 12 (остаток -59). АНПЗ (J=2) гейт прошёл (остаток 10), но
# Запросы R=3 поданы только на ПНХЗ, поэтому у ПКОП и АНПЗ остаток равен v3 (вычитается 0).

# Суммарно предоставленный в III очереди объём по НПЗ (свёртка ü по региону и субъекту).
estimated_i_j(3 from R) = sum_by_axes(normalized_i_j_k_l(3 from R)(1), Region, Market_participant) = {
    (1 from I) = {
        (1 from I, 3 from J) = 195 + 250 = 445  # 301 + 302
    }
}
    where
        normalized_i_j_k_l(3 from R)(1)(i, j, l, k) of number
        estimated_i_j(3 from R)(i, j)               of number
        normalized_i_j_k_l(3 from R)(1) of matrix(Product, Refinery, Market_participant, Region)
        estimated_i_j(3 from R)         of matrix(Product, Refinery)
            where
                n  of   index = 1 # Индекс матрицы нормирования (единственная итерация)
                Product, Market_participant, Refinery, Region from axis
                i  for I  from index # Индексы нефпродукта
                j  for J  from index # Индексы НПЗ
                l  for P  from index # Индексы субъекта рынка
                k  for K  from index # Индексы региона

# Матрица оставшихся после распределения Субъектам ГМК объёмов НП (v4 = v3 - ü).
# По ПКОП (J=1) и АНПЗ (J=2) распределения III очереди не было, поэтому остаток равен v3 (вычитается 0).
available_i_j_new(3 from R) = for_each_pair(available_i_j_new(2 from R), "-", estimated_i_j(3 from R)) = {
    (1 from I) = {
        (1 from I, 1 from J) =  -59 -   0 =  -59,
        (1 from I, 2 from J) =   10 -   0 =   10,
        (1 from I, 3 from J) = 1705 - 445 = 1260
    }
}
    where
        available_i_j_new(3 from R)(i, j) of number
        available_i_j_new(2 from R)(i, j) of number
        estimated_i_j(3 from R)(i, j)     of number
        available_i_j_new(3 from R) of matrix(Product, Refinery)
        available_i_j_new(2 from R) of matrix(Product, Refinery)
